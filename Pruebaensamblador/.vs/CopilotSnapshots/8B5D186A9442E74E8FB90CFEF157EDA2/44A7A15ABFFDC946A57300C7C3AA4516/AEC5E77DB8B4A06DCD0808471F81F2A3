.model small
.stack 100h

.data
    ; Mapa expandido a 20x15 tiles (requisito mínimo)
    mapa db '####################'
         db '#.GTCGT..#.GTCGT..#'
         db '#..++~+C.#..++~+C.#'
         db '#.T++~++T#.T++~++T#'
         db '#G.++O+.G#G.++O+.G#'
         db '#..T++TC.#..T++TC.#'
         db '#..++..E.#..++....#'
         db '####################'
         db '#GTCGT..##..GTCGT.#'
         db '#.++~+C.##.++~+C..#'
         db '#T++~++T##T++~++T.#'
         db '#.++O+.G##G.++O+..#'
         db '#.T++TC.##..T++TC.#'
         db '#.++....##..++..E.#'
         db '####################'
    
    px db 2
    py db 6
    tecla db 0
    fin db 0
    redraw db 1
    
    ; Viewport y cámara
    camera_x db 0
    camera_y db 0
    VIEWPORT_WIDTH equ 160
    VIEWPORT_HEIGHT equ 100
    VIEWPORT_TILES_X equ 10
    VIEWPORT_TILES_Y equ 6
    VIEWPORT_TILES_X_HALF equ 5
    VIEWPORT_TILES_Y_HALF equ 3
    
    ; Sistema de inventario
    gold_count db 0
    crystals_count db 0
    treasures_count db 0
    
    ; Objetivos
    gold_needed db 2
    crystals_needed db 2
    treasures_needed db 2
    
    MAPA_ANCHO equ 20
    MAPA_ALTO equ 15
    TILE_SIZE equ 16

.code
start:
    mov ax, @data
    mov ds, ax
    
    call init_screen
    
game_loop:
    cmp byte ptr [redraw], 1
    jne skip_draw
    
    call update_camera
    call clear_and_draw
    mov byte ptr [redraw], 0

skip_draw:
    call get_key_nowait
    cmp byte ptr [tecla], 0
    je game_loop
    
    call move_player
    call check_item_collection
    call check_win
    
    cmp byte ptr [fin], 1
    jne game_loop
    
    call restore_screen
    mov ax, 4c00h
    int 21h

init_screen proc
    mov ax, 0013h
    int 10h
    ret
init_screen endp

update_camera proc
    push ax
    push bx
    
    ; Centrar cámara en el jugador (simplificado)
    mov al, byte ptr [px]
    sub al, VIEWPORT_TILES_X_HALF
    cmp al, 0
    jge camera_x_positive
    mov al, 0
camera_x_positive:
    mov bl, MAPA_ANCHO - VIEWPORT_TILES_X
    cmp al, bl
    jle camera_x_valid
    mov al, bl
camera_x_valid:
    mov byte ptr [camera_x], al
    
    ; Centrar cámara en Y
    mov al, byte ptr [py]
    sub al, VIEWPORT_TILES_Y_HALF
    cmp al, 0
    jge camera_y_positive
    mov al, 0
camera_y_positive:
    mov bl, MAPA_ALTO - VIEWPORT_TILES_Y
    cmp al, bl
    jle camera_y_valid
    mov al, bl
camera_y_valid:
    mov byte ptr [camera_y], al
    
    pop bx
    pop ax
    ret
update_camera endp

clear_and_draw proc
    call clear_vga_screen
    call draw_hud
    call draw_viewport
    call draw_player
    ret
clear_and_draw endp

clear_vga_screen proc
    push ax
    push cx
    push di
    push es
    
    mov ax, 0A000h
    mov es, ax
    mov di, 0
    mov cx, 32000
    mov ax, 0
    rep stosw
    
    pop es
    pop di
    pop cx
    pop ax
    ret
clear_vga_screen endp

draw_hud proc
    push ax
    push bx
    push cx
    push dx
    
    ; Dibujar barra del HUD con gradiente
    mov dx, 0
hud_loop:
    mov cx, 0
hud_col:
    mov ah, 0Ch
    mov al, 8           ; Gris oscuro base
    cmp dx, 5
    jl hud_gradient_top
    cmp dx, 15
    jl hud_gradient_mid
    mov al, 7           ; Gris más claro abajo
    jmp hud_pixel
hud_gradient_top:
    mov al, 15          ; Blanco arriba
    jmp hud_pixel
hud_gradient_mid:
    mov al, 8           ; Gris medio
hud_pixel:
    int 10h
    inc cx
    cmp cx, 160
    jl hud_col
    inc dx
    cmp dx, 20
    jl hud_loop
    
    ; Dibujar iconos mejorados para oro, cristales y tesoros
    mov cx, 5
    mov dx, 3
    call draw_gold_icon
    
    mov cx, 25
    mov dx, 8
    mov al, byte ptr [gold_count]
    call draw_enhanced_number
    
    mov cx, 45
    mov dx, 3
    call draw_crystal_icon
    
    mov cx, 65
    mov dx, 8
    mov al, byte ptr [crystals_count]
    call draw_enhanced_number
    
    mov cx, 85
    mov dx, 3
    call draw_treasure_icon
    
    mov cx, 105
    mov dx, 8
    mov al, byte ptr [treasures_count]
    call draw_enhanced_number
    
    ; Indicador de progreso
    mov cx, 125
    mov dx, 5
    call draw_progress_indicator
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_hud endp

draw_gold_icon proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar moneda dorada circular
    mov di, 0
gold_icon_y:
    mov si, 0
gold_icon_x:
    push cx
    push dx
    
    ; Calcular distancia del centro para hacer círculo
    mov al, si
    sub al, 6           ; Centro X
    mov ah, al
    imul ah            ; X²
    mov bl, di
    sub bl, 6          ; Centro Y  
    mov bh, bl
    imul bh            ; Y²
    add al, bl         ; X² + Y²
    
    mov ah, 0Ch
    cmp al, 16         ; Radio interno
    jl gold_shine
    cmp al, 25         ; Radio externo
    jl gold_edge
    jmp gold_skip
    
gold_shine:
    mov al, 15         ; Centro brillante
    jmp gold_draw
gold_edge:
    mov al, 14         ; Borde dorado
    jmp gold_draw
    
gold_draw:
    add cx, si
    add dx, di
    int 10h
    
gold_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl gold_icon_x
    inc di
    cmp di, 12
    jl gold_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_gold_icon endp

draw_crystal_icon proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cristal con forma de diamante
    mov di, 0
crystal_icon_y:
    mov si, 0
crystal_icon_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Forma de diamante
    mov al, si
    cmp al, 6
    jl crystal_left
    sub al, 6
    jmp crystal_right
crystal_left:
    mov bl, 6
    sub bl, al
    mov al, bl
crystal_right:
    ; al ahora tiene la distancia del centro horizontal
    
    mov bl, di
    cmp bl, 6
    jl crystal_top
    sub bl, 6
    jmp crystal_bottom
crystal_top:
    mov bh, 6
    sub bh, bl
    mov bl, bh
crystal_bottom:
    ; bl ahora tiene la distancia del centro vertical
    
    add al, bl
    cmp al, 6
    jg crystal_skip
    
    mov al, 3          ; Cyan base
    test si, 1
    jz crystal_draw
    mov al, 11         ; Cyan brillante alternado
    
crystal_draw:
    add cx, si
    add dx, di
    int 10h
    
crystal_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl crystal_icon_x
    inc di
    cmp di, 12
    jl crystal_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_crystal_icon endp

draw_treasure_icon proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cofre del tesoro
    mov di, 0
treasure_icon_y:
    mov si, 0
treasure_icon_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Base del cofre
    cmp di, 8
    jl treasure_top
    mov al, 6          ; Marrón para base
    jmp treasure_draw
    
treasure_top:
    cmp di, 3
    jl treasure_lid
    cmp si, 2
    jl treasure_skip
    cmp si, 9
    jg treasure_skip
    mov al, 4          ; Rojo para cuerpo
    jmp treasure_draw
    
treasure_lid:
    cmp si, 1
    jl treasure_skip
    cmp si, 10
    jg treasure_skip
    mov al, 14         ; Dorado para tapa
    
treasure_draw:
    add cx, si
    add dx, di
    int 10h
    
treasure_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl treasure_icon_x
    inc di
    cmp di, 12
    jl treasure_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_treasure_icon endp

draw_enhanced_number proc
    push ax
    push bx
    push si
    push di
    
    ; Convertir número a dígito visual mejorado
    add al, 30h        ; Convertir a ASCII
    
    mov di, 0
number_y:
    mov si, 0
number_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 15         ; Blanco brillante
    add cx, si
    add dx, di
    int 10h
    
    ; Sombra
    push cx
    push dx
    inc cx
    inc dx
    mov al, 8          ; Gris para sombra
    int 10h
    pop dx
    pop cx
    
    pop dx
    pop cx
    inc si
    cmp si, 8
    jl number_x
    inc di
    cmp di, 10
    jl number_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_enhanced_number endp

draw_progress_indicator proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Verificar progreso total
    mov al, byte ptr [gold_count]
    mov bl, byte ptr [crystals_count]
    add al, bl
    mov bl, byte ptr [treasures_count]
    add al, bl
    
    ; Dibujar barra de progreso
    mov si, 0
progress_bar:
    push cx
    push dx
    
    mov ah, 0Ch
    cmp si, al
    jl progress_filled
    mov al, 8          ; Vacío
    jmp progress_draw
progress_filled:
    mov al, 10         ; Verde lleno
progress_draw:
    add cx, si
    int 10h
    inc dx
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, 20
    jl progress_bar
    
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_progress_indicator endp

draw_viewport proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    mov bl, byte ptr [camera_y]
    mov si, 0

viewport_y_loop:
    mov cl, byte ptr [camera_x]
    mov di, 0

viewport_x_loop:
    ; Calcular posición en el mapa
    push si
    push di
    mov al, bl
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, cl
    mov dh, 0
    add ax, dx
    mov si, ax
    
    ; Obtener tile del mapa
    mov al, byte ptr [mapa + si]
    
    ; Calcular posición en pantalla
    pop di
    pop si
    push ax
    mov al, dl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, bl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20
    mov dx, ax
    pop ax
    
    ; Dibujar tile mejorado
    call draw_enhanced_tile
    
    inc di
    inc cl
    cmp di, VIEWPORT_TILES_X
    jl viewport_x_loop
    
    inc si
    inc bl
    cmp si, VIEWPORT_TILES_Y
    jl viewport_y_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_viewport endp

draw_enhanced_tile proc
    ; AL = tipo de tile, CX,DX = posición
    push cx
    push dx
    
    cmp al, '#'
    je enhanced_wall
    cmp al, '~'
    je enhanced_water
    cmp al, 'G'
    je enhanced_gold
    cmp al, 'C'
    je enhanced_crystal
    cmp al, 'T'
    je enhanced_treasure
    cmp al, 'O'
    je enhanced_pit
    cmp al, '+'
    je enhanced_path
    cmp al, 'E'
    je enhanced_exit
    cmp al, '.'
    je enhanced_floor
    
    ; Default
    call draw_simple_tile_black
    pop dx
    pop cx
    ret

enhanced_wall:
    call draw_stone_wall
    pop dx
    pop cx
    ret

enhanced_water:
    call draw_water_waves
    pop dx
    pop cx
    ret

enhanced_path:
    call draw_stone_path
    pop dx
    pop cx
    ret

enhanced_exit:
    call draw_magical_exit
    pop dx
    pop cx
    ret

enhanced_gold:
    call draw_stone_path
    call draw_gold_coin
    pop dx
    pop cx
    ret

enhanced_crystal:
    call draw_stone_path
    call draw_crystal_gem
    pop dx
    pop cx
    ret

enhanced_treasure:
    call draw_stone_path
    call draw_treasure_chest
    pop dx
    pop cx
    ret

enhanced_pit:
    call draw_deep_hole
    pop dx
    pop cx
    ret

enhanced_floor:
    call draw_stone_floor
    pop dx
    pop cx
    ret
draw_enhanced_tile endp

draw_stone_wall proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
wall_y:
    mov si, 0
wall_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Efecto de piedra con bloques
    mov al, 7          ; Gris base
    
    ; Líneas de mortero
    mov bl, di
    and bl, 7
    cmp bl, 0
    je wall_mortar
    mov bl, si
    and bl, 7
    cmp bl, 0
    je wall_mortar
    
    ; Variaciones en la piedra
    mov bl, di
    add bl, si
    and bl, 3
    cmp bl, 0
    jne wall_normal
    mov al, 8          ; Más oscuro
    jmp wall_draw
    
wall_mortar:
    mov al, 15         ; Mortero claro
    jmp wall_draw
    
wall_normal:
    ; Sombras y luces
    cmp di, 2
    jl wall_highlight
    cmp si, 2
    jl wall_highlight
    jmp wall_draw
    
wall_highlight:
    mov al, 15
    
wall_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl wall_x
    inc di
    cmp di, TILE_SIZE
    jl wall_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_wall endp

draw_water_waves proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
water_y:
    mov si, 0
water_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 1          ; Azul base
    
    ; Crear ondas animadas
    mov bl, si
    add bl, di
    and bl, 7
    cmp bl, 0
    jne water_normal
    mov al, 9          ; Azul claro para ondas
    jmp water_draw
    
water_normal:
    and bl, 3
    cmp bl, 1
    jne water_draw
    mov al, 3          ; Cyan para reflejos
    
water_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl water_x
    inc di
    cmp di, TILE_SIZE
    jl water_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_water_waves endp

draw_stone_path proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
path_y:
    mov si, 0
path_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 14         ; Amarillo base
    
    ; Textura de adoquines
    mov bl, si
    and bl, 7
    mov bh, di
    and bh, 7
    
    cmp bl, 0
    je path_seam
    cmp bh, 0
    je path_seam
    
    ; Variación en color
    add bl, bh
    and bl, 3
    cmp bl, 1
    jne path_draw
    mov al, 6          ; Marrón para variación
    jmp path_draw
    
path_seam:
    mov al, 8          ; Gris para juntas
    
path_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl path_x
    inc di
    cmp di, TILE_SIZE
    jl path_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_path endp

draw_stone_floor proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
floor_y:
    mov si, 0
floor_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 8          ; Gris oscuro base
    
    ; Patrón de piedra simple
    mov bl, si
    add bl, di
    and bl, 15
    cmp bl, 0
    jne floor_draw
    mov al, 7          ; Más claro ocasionalmente
    
floor_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl floor_x
    inc di
    cmp di, TILE_SIZE
    jl floor_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_floor endp

draw_gold_coin proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar moneda dorada circular en el centro
    mov di, 4
coin_y:
    mov si, 4
coin_x:
    push cx
    push dx
    
    ; Círculo dorado
    mov al, si
    sub al, 8          ; Centro X
    mov ah, al
    imul ah            ; X²
    mov bl, di
    sub bl, 8          ; Centro Y
    mov bh, bl
    imul bh            ; Y²
    add al, bl
    
    mov ah, 0Ch
    cmp al, 9          ; Radio
    jg coin_skip
    
    cmp al, 4
    jl coin_shine
    mov al, 14         ; Dorado
    jmp coin_draw
coin_shine:
    mov al, 15         ; Brillo central
coin_draw:
    add cx, si
    add dx, di
    int 10h
    
coin_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl coin_x
    inc di
    cmp di, 12
    jl coin_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_gold_coin endp

draw_crystal_gem proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cristal con forma de diamante
    mov di, 5
gem_y:
    mov si, 5
gem_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Forma de diamante centrada
    mov al, si
    sub al, 8
    cmp al, 0
    jge gem_pos_x
    neg al
gem_pos_x:
    mov bl, di
    sub bl, 8
    cmp bl, 0
    jge gem_pos_y
    neg bl
gem_pos_y:
    add al, bl
    cmp al, 4
    jg gem_skip
    
    mov al, 3          ; Cyan
    cmp bl, 1
    jg gem_draw
    mov al, 11         ; Cyan brillante en centro
    
gem_draw:
    add cx, si
    add dx, di
    int 10h
    
gem_skip:
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl gem_x
    inc di
    cmp di, 11
    jl gem_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_crystal_gem endp

draw_treasure_chest proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cofre pequeño
    mov di, 5
chest_y:
    mov si, 5
chest_x:
    push cx
    push dx
    
    mov ah, 0Ch
    cmp di, 8
    jl chest_lid
    mov al, 6          ; Marrón para base
    jmp chest_draw
    
chest_lid:
    mov al, 14         ; Dorado para tapa
    cmp si, 7
    jne chest_draw
    cmp di, 6
    jne chest_draw
    mov al, 15         ; Brillo en cerradura
    
chest_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl chest_x
    inc di
    cmp di, 11
    jl chest_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_treasure_chest endp

draw_deep_hole proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
hole_y:
    mov si, 0
hole_x:
    push cx
    push dx
    
    ; Crear efecto de profundidad circular
    mov al, si
    sub al, 8
    mov ah, al
    imul ah
    mov bl, di
    sub bl, 8
    mov bh, bl
    imul bh
    add al, bl
    
    mov ah, 0Ch
    cmp al, 49         ; Radio exterior
    jg hole_edge
    cmp al, 25         ; Radio medio
    jg hole_shadow
    mov al, 0          ; Negro profundo
    jmp hole_draw
    
hole_shadow:
    mov al, 8          ; Gris para sombra
    jmp hole_draw
    
hole_edge:
    mov al, 6          ; Marrón para borde
    
hole_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl hole_x
    inc di
    cmp di, TILE_SIZE
    jl hole_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_deep_hole endp

draw_magical_exit proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
exit_y:
    mov si, 0
exit_x:
    push cx
    push dx
    
    ; Portal mágico con anillos concéntricos
    mov al, si
    sub al, 8
    mov ah, al
    imul ah
    mov bl, di
    sub bl, 8
    mov bh, bl
    imul bh
    add al, bl
    
    mov ah, 0Ch
    cmp al, 64         ; Radio exterior
    jg exit_skip
    cmp al, 49
    jg exit_ring3
    cmp al, 25
    jg exit_ring2
    cmp al, 9
    jg exit_ring1
    mov al, 15         ; Centro brillante
    jmp exit_draw
    
exit_ring1:
    mov al, 13         ; Magenta brillante
    jmp exit_draw
exit_ring2:
    mov al, 5          ; Magenta
    jmp exit_draw
exit_ring3:
    mov al, 1          ; Azul
    jmp exit_draw
    
exit_draw:
    add cx, si
    add dx, di
    int 10h
    
exit_skip:
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl exit_x
    inc di
    cmp di, TILE_SIZE
    jl exit_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_magical_exit endp

draw_simple_tile_black proc
    push ax
    push bx
    push si
    
    mov bx, 0
black_tile_row:
    mov si, 0
black_tile_col:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 0
    add dx, bx
    add cx, si
    int 10h
    pop dx
    pop cx
    
    inc si
    cmp si, TILE_SIZE
    jl black_tile_col
    inc bx
    cmp bx, TILE_SIZE
    jl black_tile_row
    
    pop si
    pop bx
    pop ax
    ret
draw_simple_tile_black endp

draw_player proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    ; Calcular posición del jugador en viewport
    mov al, byte ptr [px]
    sub al, byte ptr [camera_x]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, byte ptr [py]
    sub al, byte ptr [camera_y]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20
    mov dx, ax
    
    ; Dibujar jugador humanoide
    call draw_human_player
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_player endp

draw_human_player proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cabeza (círculo)
    mov di, 2
head_y:
    mov si, 5
head_x:
    push cx
    push dx
    
    mov al, si
    sub al, 8
    mov ah, al
    imul ah
    mov bl, di
    sub bl, 5
    mov bh, bl
    imul bh
    add al, bl
    
    mov ah, 0Ch
    cmp al, 9
    jg head_skip
    mov al, 14         ; Color piel (amarillo)
    
    add cx, si
    add dx, di
    int 10h
    
head_skip:
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl head_x
    inc di
    cmp di, 8
    jl head_y
    
    ; Dibujar cuerpo (rectángulo)
    mov di, 8
body_y:
    mov si, 6
body_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 9          ; Azul para ropa
    
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, 10
    jl body_x
    inc di
    cmp di, 12
    jl body_y
    
    ; Dibujar brazos
    mov di, 9
    mov si, 4
    push cx
    push dx
    mov ah, 0Ch
    mov al, 14         ; Color piel
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    mov si, 12
    push cx
    push dx
    mov ah, 0Ch
    mov al, 14
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    ; Dibujar piernas
    mov di, 12
legs_y:
    mov si, 6
    push cx
    push dx
    mov ah, 0Ch
    mov al, 6          ; Marrón para pantalones
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    mov si, 9
    push cx
    push dx
    mov ah, 0Ch
    mov al, 6
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    inc di
    cmp di, 15
    jl legs_y
    
    ; Ojos
    mov di, 4
    mov si, 7
    push cx
    push dx
    mov ah, 0Ch
    mov al, 0          ; Negro para ojo
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    mov si, 9
    push cx
    push dx
    mov ah, 0Ch
    mov al, 0
    add cx, si
    add dx, di
    int 10h
    pop dx
    pop cx
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_human_player endp

check_item_collection proc
    push ax
    push bx
    push si
    
    mov al, byte ptr [py]
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, byte ptr [px]
    mov dh, 0
    add ax, dx
    mov si, ax
    
    mov al, byte ptr [mapa + si]
    
    cmp al, 'G'
    je collect_gold
    cmp al, 'C'
    je collect_crystal
    cmp al, 'T'
    je collect_treasure
    jmp no_collection

collect_gold:
    inc byte ptr [gold_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1
    jmp no_collection

collect_crystal:
    inc byte ptr [crystals_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1
    jmp no_collection

collect_treasure:
    inc byte ptr [treasures_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1

no_collection:
    pop si
    pop bx
    pop ax
    ret
check_item_collection endp

get_key_nowait proc
    mov byte ptr [tecla], 0
    mov ah, 01h
    int 16h
    jz no_key_available
    
    mov ah, 00h
    int 16h
    mov byte ptr [tecla], al

no_key_available:
    ret
get_key_nowait endp

move_player proc
    mov al, byte ptr [tecla]
    
    cmp al, 27
    je salir_juego
    
    cmp al, 'w'
    je mover_arriba
    cmp al, 'W'
    je mover_arriba
    
    cmp al, 's'
    je mover_abajo
    cmp al, 'S'
    je mover_abajo
    
    cmp al, 'a'
    je mover_izquierda
    cmp al, 'A'
    je mover_izquierda
    
    cmp al, 'd'
    je mover_derecha
    cmp al, 'D'
    je mover_derecha
    
    ret

salir_juego:
    mov byte ptr [fin], 1
    ret

mover_arriba:
    cmp byte ptr [py], 0
    je movimiento_invalido
    dec byte ptr [py]
    call validar_movimiento
    ret

mover_abajo:
    cmp byte ptr [py], MAPA_ALTO-1
    je movimiento_invalido
    inc byte ptr [py]
    call validar_movimiento
    ret

mover_izquierda:
    cmp byte ptr [px], 0
    je movimiento_invalido
    dec byte ptr [px]
    call validar_movimiento
    ret

mover_derecha:
    cmp byte ptr [px], MAPA_ANCHO-1
    je movimiento_invalido
    inc byte ptr [px]
    call validar_movimiento
    ret

movimiento_invalido:
    ret
move_player endp

validar_movimiento proc
    push ax
    push bx
    push si
    
    mov al, byte ptr [py]
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, byte ptr [px]
    mov dh, 0
    add ax, dx
    mov si, ax
    
    mov al, byte ptr [mapa + si]
    cmp al, '#'
    je deshacer_movimiento
    cmp al, '~'
    je deshacer_movimiento
    cmp al, 'O'
    je deshacer_movimiento
    
    mov byte ptr [redraw], 1
    jmp fin_validacion

deshacer_movimiento:
    mov al, byte ptr [tecla]
    cmp al, 'w'
    je deshacer_arriba
    cmp al, 'W'
    je deshacer_arriba
    cmp al, 's'
    je deshacer_abajo
    cmp al, 'S'
    je deshacer_abajo
    cmp al, 'a'
    je deshacer_izquierda
    cmp al, 'A'
    je deshacer_izquierda
    cmp al, 'd'
    je deshacer_derecha
    cmp al, 'D'
    je deshacer_derecha
    jmp fin_validacion

deshacer_arriba:
    inc byte ptr [py]
    jmp fin_validacion
deshacer_abajo:
    dec byte ptr [py]
    jmp fin_validacion
deshacer_izquierda:
    inc byte ptr [px]
    jmp fin_validacion
deshacer_derecha:
    dec byte ptr [px]
    jmp fin_validacion

fin_validacion:
    pop si
    pop bx
    pop ax
    ret
validar_movimiento endp

check_win proc
    push ax
    push bx
    push si
    
    mov al, byte ptr [gold_count]
    cmp al, byte ptr [gold_needed]
    jl no_ganaste
    
    mov al, byte ptr [crystals_count]
    cmp al, byte ptr [crystals_needed]
    jl no_ganaste
    
    mov al, byte ptr [treasures_count]
    cmp al, byte ptr [treasures_needed]
    jl no_ganaste
    
    mov al, byte ptr [py]
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, byte ptr [px]
    mov dh, 0
    add ax, dx
    mov si, ax
    
    cmp byte ptr [mapa + si], 'E'
    jne no_ganaste
    
    ; Cambiar a modo texto
    mov ax, 0003h
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_victoria
    int 21h
    
    mov ah, 07h
    int 21h
    mov byte ptr [fin], 1

no_ganaste:
    pop si
    pop bx
    pop ax
    ret

mensaje_victoria db 'FELICIDADES! Has completado el juego! Presiona cualquier tecla...$'
check_win endp

restore_screen proc
    mov ax, 0003h
    int 10h
    
    mov ah, 01h
    mov cx, 0607h
    int 10h
    ret
restore_screen endp

