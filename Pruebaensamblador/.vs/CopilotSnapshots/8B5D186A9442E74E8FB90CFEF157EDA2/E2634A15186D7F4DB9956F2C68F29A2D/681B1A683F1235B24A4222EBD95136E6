.model small
.stack 100h

.data
    mapa db '##########'
         db '#.GTCGT..#'
         db '#..++~+C.#'
         db '#.T++~++T#'
         db '#G.++O+.G#'
         db '#..T++TC.#'
         db '#..++..E.#'
         db '##########'
    
    px db 2
    py db 6
    tecla db 0
    fin db 0
    redraw db 1
    
    ; Sistema de inventario
    gold_count db 0
    crystals_count db 0
    treasures_count db 0
    
    ; Objetivos (necesitamos 2 de cada uno)
    gold_needed db 2
    crystals_needed db 2
    treasures_needed db 2
    
    MAPA_ANCHO equ 10
    MAPA_ALTO equ 8
    TILE_SIZE equ 20
    TILE_HALF equ 10
    
    ; Patrones de sprites (8x8 pixels cada uno) - usando valores hexadecimales
    player_sprite db 00h, 38h, 7Ch, 0FEh, 7Ch, 38h, 28h, 54h
    
    gold_sprite   db 38h, 7Ch, 0FEh, 0FEh, 0FEh, 7Ch, 38h, 10h
    
    crystal_sprite db 10h, 38h, 7Ch, 0FEh, 7Ch, 38h, 10h, 00h
    
    treasure_sprite db 0FFh, 81h, 0BDh, 0A5h, 0BDh, 81h, 0FFh, 00h

.code
start:
    mov ax, @data
    mov ds, ax
    
    call init_screen
    
game_loop:
    cmp byte ptr [redraw], 1
    jne skip_draw
    
    call clear_and_draw
    mov byte ptr [redraw], 0

skip_draw:
    call get_key_nowait
    cmp byte ptr [tecla], 0
    je game_loop
    
    call move_player
    call check_item_collection
    call check_win
    
    cmp byte ptr [fin], 1
    jne game_loop
    
    call restore_screen
    mov ax, 4c00h
    int 21h

init_screen proc
    mov ax, 0013h
    int 10h
    ret
init_screen endp

clear_and_draw proc
    ; Limpiar pantalla
    call clear_vga_screen
    
    ; Dibujar HUD
    call draw_hud
    
    ; Dibujar mapa completo
    call draw_full_map
    
    ; Dibujar jugador encima
    call draw_player
    ret
clear_and_draw endp

clear_vga_screen proc
    push ax
    push cx
    push di
    push es
    
    mov ax, 0A000h
    mov es, ax
    mov di, 0
    mov cx, 32000
    mov ax, 0
    rep stosw
    
    pop es
    pop di
    pop cx
    pop ax
    ret
clear_vga_screen endp

draw_hud proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Dibujar barra superior del HUD con gradiente
    mov dx, 0
hud_row_loop:
    mov cx, 0
hud_col_loop:
    mov ah, 0Ch
    mov al, 8
    cmp dx, 10
    jl hud_darker
    mov al, 7
hud_darker:
    int 10h
    inc cx
    cmp cx, 320
    jl hud_col_loop
    inc dx
    cmp dx, 35
    jl hud_row_loop
    
    ; Dibujar iconos mejorados y contadores
    mov cx, 15
    mov dx, 10
    call draw_detailed_gold_icon
    
    mov cx, 35
    mov dx, 15
    mov al, byte ptr [gold_count]
    call draw_large_digit
    
    mov cx, 70
    mov dx, 10
    call draw_detailed_crystal_icon
    
    mov cx, 90
    mov dx, 15
    mov al, byte ptr [crystals_count]
    call draw_large_digit
    
    mov cx, 125
    mov dx, 10
    call draw_detailed_treasure_icon
    
    mov cx, 145
    mov dx, 15
    mov al, byte ptr [treasures_count]
    call draw_large_digit
    
    ; Indicador de objetivo mejorado
    mov cx, 200
    mov dx, 10
    call draw_enhanced_objective_status
    
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_hud endp

draw_detailed_gold_icon proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    ; Dibujar círculo dorado con brillo
    lea si, gold_sprite
    mov di, 0
    
gold_icon_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
gold_bit_loop:
    test al, 80h
    jz gold_skip_pixel
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    mov al, 14          ; Amarillo brillante
    add cx, bx
    add dx, di
    int 10h
    ; Agregar brillo
    cmp bx, 3
    jne no_gold_shine
    cmp di, 3
    jne no_gold_shine
    mov al, 15          ; Blanco para brillo
    int 10h
no_gold_shine:
    pop dx
    pop cx
    pop bx
    pop ax
    
gold_skip_pixel:
    shl al, 1
    inc bx
    cmp bx, 8
    jl gold_bit_loop
    
    inc di
    cmp di, 8
    jl gold_icon_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_detailed_gold_icon endp

draw_detailed_crystal_icon proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    lea si, crystal_sprite
    mov di, 0
    
crystal_icon_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
crystal_bit_loop:
    test al, 80h
    jz crystal_skip_pixel
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    ; Alternar entre cyan y azul para efecto cristal
    mov al, 3
    test di, 1
    jz crystal_color_set
    mov al, 9
crystal_color_set:
    add cx, bx
    add dx, di
    int 10h
    pop dx
    pop cx
    pop bx
    pop ax
    
crystal_skip_pixel:
    shl al, 1
    inc bx
    cmp bx, 8
    jl crystal_bit_loop
    
    inc di
    cmp di, 8
    jl crystal_icon_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_detailed_crystal_icon endp

draw_detailed_treasure_icon proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    lea si, treasure_sprite
    mov di, 0
    
treasure_icon_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
treasure_bit_loop:
    test al, 80h
    jz treasure_skip_pixel
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    mov al, 4           ; Rojo
    ; Borde dorado
    cmp di, 0
    je treasure_gold_border
    cmp di, 6
    je treasure_gold_border
    cmp bx, 0
    je treasure_gold_border
    cmp bx, 7
    je treasure_gold_border
    jmp treasure_normal_color
treasure_gold_border:
    mov al, 14          ; Dorado
treasure_normal_color:
    add cx, bx
    add dx, di
    int 10h
    pop dx
    pop cx
    pop bx
    pop ax
    
treasure_skip_pixel:
    shl al, 1
    inc bx
    cmp bx, 8
    jl treasure_bit_loop
    
    inc di
    cmp di, 8
    jl treasure_icon_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_detailed_treasure_icon endp

draw_large_digit proc
    ; AL = dígito (0-9), CX, DX = posición
    push ax
    push bx
    push si
    push di
    
    ; Dibujar dígito 3D
    mov bx, 0
large_digit_y:
    mov si, 0
large_digit_x:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 15          ; Blanco
    ; Sombra
    add cx, si
    add cx, 1
    add dx, bx
    add dx, 1
    int 10h
    ; Número principal
    sub cx, 1
    sub dx, 1
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl large_digit_x
    inc bx
    cmp bx, 15
    jl large_digit_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_large_digit endp

draw_enhanced_objective_status proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Verificar objetivos completos
    mov al, byte ptr [gold_count]
    cmp al, byte ptr [gold_needed]
    jl obj_incomplete
    
    mov al, byte ptr [crystals_count]
    cmp al, byte ptr [crystals_needed]
    jl obj_incomplete
    
    mov al, byte ptr [treasures_count]
    cmp al, byte ptr [treasures_needed]
    jl obj_incomplete
    
    ; Completo - verde pulsante
    mov al, 2
    mov bx, 10          ; Verde brillante
    jmp draw_status_enhanced

obj_incomplete:
    ; Incompleto - amarillo parpadeante
    mov al, 14
    mov bx, 6           ; Amarillo oscuro

draw_status_enhanced:
    ; Dibujar indicador con efectos
    push cx
    push dx
    mov si, 0
status_y_enh:
    mov di, 0
status_x_enh:
    push cx
    push dx
    mov ah, 0Ch
    ; Alternar colores para efecto
    test si, 1
    jz status_color1
    mov al, bl
status_color1:
    add cx, di
    add dx, si
    int 10h
    pop dx
    pop cx
    inc di
    cmp di, 30
    jl status_x_enh
    inc si
    cmp si, 12
    jl status_y_enh
    pop dx
    pop cx
    
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_enhanced_objective_status endp

check_item_collection proc
    push ax
    push bx
    push si
    
    ; Calcular posición en el mapa
    mov al, byte ptr [py]
    mov bl, MAPA_ANCHO
    mul bl
    xor bh, bh
    mov bl, byte ptr [px]
    add ax, bx
    mov si, ax
    
    ; Verificar item
    mov al, byte ptr [mapa + si]
    
    cmp al, 'G'
    je collect_gold
    cmp al, 'C'
    je collect_crystal
    cmp al, 'T'
    je collect_treasure
    jmp no_collection

collect_gold:
    inc byte ptr [gold_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1
    jmp no_collection

collect_crystal:
    inc byte ptr [crystals_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1
    jmp no_collection

collect_treasure:
    inc byte ptr [treasures_count]
    mov byte ptr [mapa + si], '+'
    mov byte ptr [redraw], 1

no_collection:
    pop si
    pop bx
    pop ax
    ret
check_item_collection endp

draw_full_map proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    mov si, 0
    mov bx, 0

map_fila:
    mov di, 0

map_columna:
    mov ax, bx
    mov dl, TILE_SIZE
    mul dl
    add ax, 40          ; Offset para HUD más grande
    push ax
    
    mov ax, di
    mov dl, TILE_SIZE
    mul dl
    mov cx, ax
    pop dx
    
    mov al, byte ptr [mapa + si]
    call draw_enhanced_tile
    
    inc si
    inc di
    cmp di, MAPA_ANCHO
    jl map_columna
    
    inc bx
    cmp bx, MAPA_ALTO
    jl map_fila
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_full_map endp

validar_movimiento proc
    push ax
    push bx
    push si
    
    mov al, byte ptr [py]
    mov bl, MAPA_ANCHO
    mul bl
    xor bh, bh
    mov bl, byte ptr [px]
    add ax, bx
    mov si, ax
    
    mov al, byte ptr [mapa + si]
    cmp al, '#'
    je deshacer_movimiento
    cmp al, '~'
    je deshacer_movimiento
    cmp al, 'O'
    je deshacer_movimiento
    
    mov byte ptr [redraw], 1
    jmp fin_validacion

deshacer_movimiento:
    mov al, byte ptr [tecla]
    cmp al, 'w'
    je deshacer_arriba
    cmp al, 'W'
    je deshacer_arriba
    cmp al, 's'
    je deshacer_abajo
    cmp al, 'S'
    je deshacer_abajo
    cmp al, 'a'
    je deshacer_izquierda
    cmp al, 'A'
    je deshacer_izquierda
    cmp al, 'd'
    je deshacer_derecha
    cmp al, 'D'
    je deshacer_derecha
    jmp fin_validacion

deshacer_arriba:
    inc byte ptr [py]
    jmp fin_validacion
deshacer_abajo:
    dec byte ptr [py]
    jmp fin_validacion
deshacer_izquierda:
    inc byte ptr [px]
    jmp fin_validacion
deshacer_derecha:
    dec byte ptr [px]
    jmp fin_validacion

fin_validacion:
    pop si
    pop bx
    pop ax
    ret
validar_movimiento endp

draw_enhanced_tile proc
    ; AL = tipo de tile, CX,DX = posición
    push cx
    push dx
    
    cmp al, '#'
    je enhanced_wall
    cmp al, '~'
    je enhanced_water
    cmp al, 'G'
    je enhanced_gold
    cmp al, 'C'
    je enhanced_crystal
    cmp al, 'T'
    je enhanced_treasure
    cmp al, 'O'
    je enhanced_pit
    cmp al, '+'
    je enhanced_path
    cmp al, 'E'
    je enhanced_exit
    
    ; Default tile
    mov al, 2
    jmp dibujar_enhanced_tile

enhanced_wall:
    call draw_3d_wall
    pop dx
    pop cx
    ret

enhanced_water:
    call draw_animated_water
    pop dx
    pop cx
    ret

enhanced_path:
    call draw_stone_path
    pop dx
    pop cx
    ret

enhanced_exit:
    call draw_glowing_exit
    pop dx
    pop cx
    ret

enhanced_gold:
    call draw_stone_path
    call draw_sprite_gold
    pop dx
    pop cx
    ret

enhanced_crystal:
    call draw_stone_path
    call draw_sprite_crystal
    pop dx
    pop cx
    ret

enhanced_treasure:
    call draw_stone_path
    call draw_sprite_treasure
    pop dx
    pop cx
    ret

enhanced_pit:
    call draw_deep_pit
    pop dx
    pop cx
    ret

dibujar_enhanced_tile:
    push ax
    push bx
    push si
    
    mov bx, 0
enh_tile_row:
    mov si, 0
enh_tile_col:
    push ax
    push cx
    push dx
    mov ah, 0Ch
    add dx, bx
    add cx, si
    int 10h
    pop dx
    pop cx
    pop ax
    
    inc si
    cmp si, TILE_SIZE
    jl enh_tile_col
    inc bx
    cmp bx, TILE_SIZE
    jl enh_tile_row
    
    pop si
    pop bx
    pop ax
    pop dx
    pop cx
    ret
draw_enhanced_tile endp

draw_3d_wall proc
    push ax
    push bx
    push si
    push di
    
    mov bx, 0
wall_row:
    mov si, 0
wall_col:
    push cx
    push dx
    mov ah, 0Ch
    ; Efecto 3D con gradiente
    mov al, 7           ; Gris claro base
    cmp bx, 2
    jl wall_highlight
    mov di, TILE_SIZE
    sub di, 3
    cmp bx, di
    jg wall_shadow
    cmp si, 2
    jl wall_highlight
    mov di, TILE_SIZE
    sub di, 3
    cmp si, di
    jg wall_shadow
    mov al, 8           ; Gris medio
    jmp wall_draw
wall_highlight:
    mov al, 15          ; Blanco (highlight)
    jmp wall_draw
wall_shadow:
    mov al, 0           ; Negro (sombra)
wall_draw:
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl wall_col
    inc bx
    cmp bx, TILE_SIZE
    jl wall_row
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_3d_wall endp

draw_animated_water proc
    push ax
    push bx
    push si
    push di
    
    mov bx, 0
water_row:
    mov si, 0
water_col:
    push cx
    push dx
    mov ah, 0Ch
    ; Animación simple de agua
    mov al, 1           ; Azul base
    ; Crear ondas
    mov di, si
    add di, bx
    test di, 3
    jnz water_normal
    mov al, 9           ; Azul claro
water_normal:
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl water_col
    inc bx
    cmp bx, TILE_SIZE
    jl water_row
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_animated_water endp

draw_stone_path proc
    push ax
    push bx
    push si
    push di
    
    mov bx, 0
stone_row:
    mov si, 0
stone_col:
    push cx
    push dx
    mov ah, 0Ch
    ; Textura de piedra
    mov al, 7           ; Gris base
    mov di, si
    add di, bx
    test di, 7
    jnz stone_normal
    mov al, 8           ; Puntos más oscuros
stone_normal:
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl stone_col
    inc bx
    cmp bx, TILE_SIZE
    jl stone_row
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_path endp

draw_glowing_exit proc
    push ax
    push bx
    push si
    push di
    
    mov bx, 0
exit_row:
    mov si, 0
exit_col:
    push cx
    push dx
    mov ah, 0Ch
    ; Efecto de brillo pulsante
    mov al, 5           ; Magenta base
    mov di, si
    sub di, TILE_HALF
    mov ax, di
    imul ax, di
    push si
    mov si, bx
    sub si, TILE_HALF
    push ax
    mov ax, si
    imul ax, si
    pop di
    add di, ax
    pop si
    cmp di, 25          ; Radio del brillo
    jg exit_normal
    mov al, 13          ; Magenta brillante
exit_normal:
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl exit_col
    inc bx
    cmp bx, TILE_SIZE
    jl exit_row
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_glowing_exit endp

draw_deep_pit proc
    push ax
    push bx
    push si
    push di
    
    mov bx, 0
pit_row:
    mov si, 0
pit_col:
    push cx
    push dx
    mov ah, 0Ch
    ; Efecto de profundidad
    mov al, 0           ; Negro profundo
    mov di, si
    sub di, TILE_HALF
    mov ax, di
    imul ax, di
    push si
    mov si, bx
    sub si, TILE_HALF
    push ax
    mov ax, si
    imul ax, si
    pop di
    add di, ax
    pop si
    cmp di, 16          ; Radio del borde
    jl pit_deep
    cmp di, 49          ; Radio exterior
    jg pit_edge
    mov al, 8           ; Gris oscuro
    jmp pit_draw
pit_edge:
    mov al, 6           ; Marrón
    jmp pit_draw
pit_deep:
    mov al, 0           ; Negro
pit_draw:
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl pit_col
    inc bx
    cmp bx, TILE_SIZE
    jl pit_row
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_deep_pit endp

draw_sprite_gold proc
    push ax
    push bx
    push si
    push di
    
    ; Centrar el sprite en el tile
    lea si, gold_sprite
    mov di, 0
    
sprite_gold_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
sprite_gold_bit_loop:
    test al, 80h
    jz sprite_gold_skip
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    mov al, 14          ; Oro brillante
    add cx, bx
    add cx, 6           ; TILE_HALF - 4
    add dx, di
    add dx, 6           ; TILE_HALF - 4
    int 10h
    ; Efecto de brillo
    cmp bx, 3
    jne no_gold_sparkle
    cmp di, 3
    jne no_gold_sparkle
    mov al, 15
    int 10h
no_gold_sparkle:
    pop dx
    pop cx
    pop bx
    pop ax
    
sprite_gold_skip:
    shl al, 1
    inc bx
    cmp bx, 8
    jl sprite_gold_bit_loop
    
    inc di
    cmp di, 8
    jl sprite_gold_loop
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_sprite_gold endp

draw_sprite_crystal proc
    push ax
    push bx
    push si
    push di
    
    lea si, crystal_sprite
    mov di, 0
    
sprite_crystal_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
sprite_crystal_bit_loop:
    test al, 80h
    jz sprite_crystal_skip
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    ; Efecto cristalino
    mov al, 3           ; Cyan
    test di, 1
    jz crystal_color_ok
    mov al, 11          ; Cyan brillante
crystal_color_ok:
    add cx, bx
    add cx, 6           ; TILE_HALF - 4
    add dx, di
    add dx, 6           ; TILE_HALF - 4
    int 10h
    pop dx
    pop cx
    pop bx
    pop ax
    
sprite_crystal_skip:
    shl al, 1
    inc bx
    cmp bx, 8
    jl sprite_crystal_bit_loop
    
    inc di
    cmp di, 8
    jl sprite_crystal_loop
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_sprite_crystal endp

draw_sprite_treasure proc
    push ax
    push bx
    push si
    push di
    
    lea si, treasure_sprite
    mov di, 0
    
sprite_treasure_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
sprite_treasure_bit_loop:
    test al, 80h
    jz sprite_treasure_skip
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    mov al, 4           ; Rojo
    ; Borde dorado
    cmp di, 0
    je treasure_gold_edge
    cmp di, 6
    je treasure_gold_edge
    cmp bx, 0
    je treasure_gold_edge
    cmp bx, 7
    je treasure_gold_edge
    jmp treasure_color_ok
treasure_gold_edge:
    mov al, 14          ; Dorado
treasure_color_ok:
    add cx, bx
    add cx, 6           ; TILE_HALF - 4
    add dx, di
    add dx, 6           ; TILE_HALF - 4
    int 10h
    pop dx
    pop cx
    pop bx
    pop ax
    
sprite_treasure_skip:
    shl al, 1
    inc bx
    cmp bx, 8
    jl sprite_treasure_bit_loop
    
    inc di
    cmp di, 8
    jl sprite_treasure_loop
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_sprite_treasure endp

draw_player proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    ; Calcular posición del jugador
    mov al, byte ptr [px]
    mov bl, TILE_SIZE
    mul bl
    mov cx, ax
    
    mov al, byte ptr [py]
    mov bl, TILE_SIZE
    mul bl
    add ax, 40          ; Offset del HUD
    mov dx, ax
    
    ; Dibujar sprite del jugador
    lea si, player_sprite
    mov di, 0
    
player_sprite_loop:
    mov al, byte ptr [si + di]
    mov bx, 0
    
player_bit_loop:
    test al, 80h
    jz player_skip_pixel
    
    push ax
    push bx
    push cx
    push dx
    mov ah, 0Ch
    mov al, 12          ; Rojo brillante para el jugador
    ; Efecto de contorno
    push cx
    push dx
    ; Sombra
    inc cx
    inc dx
    mov al, 0
    int 10h
    dec cx
    dec dx
    mov al, 12
    int 10h
    pop dx
    pop cx
    
    add cx, bx
    add cx, 6           ; TILE_HALF - 4
    add dx, di
    add dx, 6           ; TILE_HALF - 4
    int 10h
    pop dx
    pop cx
    pop bx
    pop ax
    
player_skip_pixel:
    shl al, 1
    inc bx
    cmp bx, 8
    jl player_bit_loop
    
    inc di
    cmp di, 8
    jl player_sprite_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_player endp

get_key_nowait proc
    mov byte ptr [tecla], 0
    mov ah, 01h
    int 16h
    jz no_key_available
    
    mov ah, 00h
    int 16h
    mov byte ptr [tecla], al

no_key_available:
    ret
get_key_nowait endp

move_player proc
    mov al, byte ptr [tecla]
    
    cmp al, 27
    je salir_juego
    
    cmp al, 'w'
    je mover_arriba
    cmp al, 'W'
    je mover_arriba
    
    cmp al, 's'
    je mover_abajo
    cmp al, 'S'
    je mover_abajo
    
    cmp al, 'a'
    je mover_izquierda
    cmp al, 'A'
    je mover_izquierda
    
    cmp al, 'd'
    je mover_derecha
    cmp al, 'D'
    je mover_derecha
    
    ret

salir_juego:
    mov byte ptr [fin], 1
    ret

mover_arriba:
    cmp byte ptr [py], 0
    je movimiento_invalido
    dec byte ptr [py]
    call validar_movimiento
    ret

mover_abajo:
    cmp byte ptr [py], MAPA_ALTO-1
    je movimiento_invalido
    inc byte ptr [py]
    call validar_movimiento
    ret

mover_izquierda:
    cmp byte ptr [px], 0
    je movimiento_invalido
    dec byte ptr [px]
    call validar_movimiento
    ret

mover_derecha:
    cmp byte ptr [px], MAPA_ANCHO-1
    je movimiento_invalido
    inc byte ptr [px]
    call validar_movimiento
    ret

movimiento_invalido:
    ret
move_player endp

check_win proc
    push ax
    push bx
    push si
    
    mov al, byte ptr [gold_count]
    cmp al, byte ptr [gold_needed]
    jl no_ganaste
    
    mov al, byte ptr [crystals_count]
    cmp al, byte ptr [crystals_needed]
    jl no_ganaste
    
    mov al, byte ptr [treasures_count]
    cmp al, byte ptr [treasures_needed]
    jl no_ganaste
    
    mov al, byte ptr [py]
    mov bl, MAPA_ANCHO
    mul bl
    xor bh, bh
    mov bl, byte ptr [px]
    add ax, bx
    mov si, ax
    
    cmp byte ptr [mapa + si], 'E'
    jne no_ganaste
    
    ; Cambiar a modo texto para mensaje
    mov ax, 0003h
    int 10h
    
    mov ah, 09h
    lea dx, mensaje_victoria
    int 21h
    
    mov ah, 07h
    int 21h
    mov byte ptr [fin], 1

no_ganaste:
    pop si
    pop bx
    pop ax
    ret

mensaje_victoria db 'FELICIDADES! Completaste la aventura! Presiona cualquier tecla...$'
check_win endp

restore_screen proc
    mov ax, 0003h
    int 10h
    
    mov ah, 01h
    mov cx, 0607h
    int 10h
    ret
restore_screen endp

end start