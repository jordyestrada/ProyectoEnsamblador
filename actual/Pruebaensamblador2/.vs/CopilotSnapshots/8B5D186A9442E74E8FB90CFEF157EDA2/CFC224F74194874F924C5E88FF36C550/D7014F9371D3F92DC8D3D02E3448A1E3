    int 10h
    mov al, 'a'
    int 10h
    mov al, ' '
    int 10h
    mov al, 's'
    int 10h
    mov al, 'a'
    int 10h
    mov al, 'l'
    int 10h
    mov al, 'i'
    int 10h
    mov al, 'd'
    int 10h
    mov al, 'a'
    int 10h
