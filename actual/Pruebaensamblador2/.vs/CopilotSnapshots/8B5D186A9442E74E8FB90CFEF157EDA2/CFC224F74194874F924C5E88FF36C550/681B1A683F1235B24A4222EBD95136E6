draw_player_to_buffer proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Calcular posición del jugador en viewport
    mov al, byte ptr [px]
    sub al, byte ptr [camera_x]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    shl ax, 1           ; Escalar para EGA
    mov cx, ax
    
    mov al, byte ptr [py]
    sub al, byte ptr [camera_y]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 30          ; Offset para HUD en EGA
    mov dx, ax
    
    ; Solo dibujar si está visible en viewport
    cmp cx, 320
    jg player_skip_buf
    cmp dx, 130
    jg player_skip_buf
    
    call draw_animated_player_sprite
    
player_skip_buf:
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_player_to_buffer endp

update_player_animation proc
    push ax
    
    ; Actualizar contador de animación
    inc byte ptr [animation_counter]
    cmp byte ptr [animation_counter], 8  ; Velocidad de animación
    jl no_frame_update
    
    ; Reiniciar contador y avanzar frame
    mov byte ptr [animation_counter], 0
    inc byte ptr [player_frame]
    cmp byte ptr [player_frame], 4  ; 4 frames de animación
    jl no_frame_update
    mov byte ptr [player_frame], 0
    
no_frame_update:
    pop ax
    ret
update_player_animation endp

draw_animated_player_sprite proc
    push ax
    push bx
    push si
    
    ; Obtener el sprite actual basado en dirección y frame
    mov al, byte ptr [player_direction]
    mov bl, byte ptr [player_frame]
    
    ; Dibujar sprite animado del jugador
    ; Frame 0 y 2: posición neutral
    ; Frame 1: pierna izquierda adelante  
    ; Frame 3: pierna derecha adelante
    
    ; Cabeza (siempre igual)
    mov bx, 2
    mov si, 8
head_anim_y:
    push si
    mov si, 8
head_anim_x:
    push cx
    push dx
    mov al, 14          ; Amarillo para piel
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc si
    cmp si, 24          ; Más grande para EGA
    jl head_anim_x
    pop si
    inc bx
    cmp bx, 12
    jl head_anim_y
    
    ; Cuerpo (siempre igual)
    mov bx, 12
body_anim_y:
    mov si, 10
body_anim_x:
    push cx
    push dx
    mov al, 9           ; Azul para ropa
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc si
    cmp si, 22
    jl body_anim_x
    inc bx
    cmp bx, 22
    jl body_anim_y
    
    ; Brazos animados según dirección
    call draw_animated_arms
    
    ; Piernas animadas según frame
    call draw_animated_legs
    
    ; Ojos
    mov bx, 6
    mov si, 12
    push cx
    push dx
    mov al, 0           ; Negro
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    
    mov si, 20
    push cx
    push dx
    mov al, 0
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    
    pop si
    pop bx
    pop ax
    ret
draw_animated_player_sprite endp

draw_animated_arms proc
    push ax
    push bx
    push si
    
    ; Brazos con animación según dirección
    mov al, byte ptr [player_direction]
    
    cmp al, 2           ; Izquierda
    je arms_left
    cmp al, 3           ; Derecha  
    je arms_right
    
    ; Brazos normales (arriba/abajo)
arms_normal:
    mov bx, 14
    mov si, 4
    push cx
    push dx
    mov al, 14          ; Piel
    add cx, si
    add dx, bx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    pop dx
    pop cx
    
    mov si, 28
    push cx
    push dx
    mov al, 14
    add cx, si
    add dx, bx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    pop dx
    pop cx
    jmp arms_end
    
arms_left:
    ; Brazo izquierdo extendido
    mov bx, 14
    mov si, 2
    push cx
    push dx
    mov al, 14
    add cx, si
    add dx, bx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    pop dx
    pop cx
    jmp arms_end
    
arms_right:
    ; Brazo derecho extendido
    mov bx, 14
    mov si, 26
    push cx
    push dx
    mov al, 14
    add cx, si
    add dx, bx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    inc cx
    call put_pixel_buffer
    pop dx
    pop cx

arms_end:
    pop si
    pop bx
    pop ax
    ret
draw_animated_arms endp

