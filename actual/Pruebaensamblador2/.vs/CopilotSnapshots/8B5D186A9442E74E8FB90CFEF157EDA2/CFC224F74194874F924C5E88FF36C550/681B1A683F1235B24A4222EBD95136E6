.model small
.stack 100h

.data
    ; Mapa expandido a 20x15 tiles (requisito mínimo)
    mapa db '####################'
         db '#.GTCGT..#.GTCGT..#'
         db '#..++~+C.#..++~+C.#'
         db '#.T++~++T#.T++~++T#'
         db '#G.++O+.G#G.++O+.G#'
         db '#..T++TC.#..T++TC.#'
         db '#..++..E.#..++....#'
         db '####################'
         db '#GTCGT..##..GTCGT.#'
         db '#.++~+C.##.++~+C..#'
         db '#T++~++T##T++~++T.#'
         db '#.++O+.G##G.++O+..#'
         db '#.T++TC.##..T++TC.#'
         db '#.++....##..++..E.#'
         db '####################'
    
    px db 2
    py db 1
    tecla db 0
    fin db 0
    redraw db 1
    
    ; Viewport y cámara
    camera_x db 0
    camera_y db 0
    VIEWPORT_WIDTH equ 160
    VIEWPORT_HEIGHT equ 100
    VIEWPORT_TILES_X equ 10
    VIEWPORT_TILES_Y equ 6
    VIEWPORT_TILES_X_HALF equ 5
    VIEWPORT_TILES_Y_HALF equ 3
    
    ; Sistema de inventario
    gold_count db 0
    crystals_count db 0
    treasures_count db 0
    
    ; Objetivos
    gold_needed db 2
    crystals_needed db 2
    treasures_needed db 2
    
    MAPA_ANCHO equ 20
    MAPA_ALTO equ 15
    TILE_SIZE equ 16
    
    ; Sistema de animación del personaje
    player_direction db 0    ; 0=abajo, 1=arriba, 2=izquierda, 3=derecha
    player_frame db 0        ; Frame actual de animación (0-3)
    animation_counter db 0   ; Contador para velocidad de animación
    
    ; Sistema de doble buffer - Buffer oculto en memoria convencional
    buffer_segment dw 0      ; Segmento del buffer oculto
    buffer_size equ 28000    ; Tamaño del buffer para EGA (640x350/8 * 4 planos)
    
    ; Mensajes informativos
    mensaje_titulo db 'ADVENTURE QUEST - Recolecta tesoros y escapa!$'
    mensaje_controles db 'Controles: WASD para mover, ESC para salir$'
    mensaje_objetivo db 'Objetivo: Recolecta 2 ORO, 2 CRISTALES, 2 TESOROS$'
    mensaje_estado db 'Oro: 0/2  Cristales: 0/2  Tesoros: 0/2$'

.code
start:
    mov ax, @data
    mov ds, ax
    
    call show_intro
    call init_ega_mode
    call allocate_buffer
    
game_loop:
    cmp byte ptr [redraw], 1
    jne skip_draw
    
    call update_camera
    call clear_and_draw_buffered
    mov byte ptr [redraw], 0

skip_draw:
    call get_key_nowait
    cmp byte ptr [tecla], 0
    je game_loop
    
    call move_player
    call update_player_animation
    call check_item_collection
    call check_win
    
    cmp byte ptr [fin], 1
    jne game_loop
    
    call deallocate_buffer
    call restore_screen
    mov ax, 4c00h
    int 21h

show_intro proc
    ; Mostrar pantalla de introducción
    mov ax, 0003h       ; Modo texto
    int 10h
    
    ; Posicionar cursor y mostrar título
    mov ah, 02h
    mov bh, 0
    mov dh, 5           ; Fila 5
    mov dl, 10          ; Columna 10
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_titulo
    int 21h
    
    ; Mostrar controles
    mov ah, 02h
    mov dh, 8
    mov dl, 15
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_controles
    int 21h
    
    ; Mostrar objetivo
    mov ah, 02h
    mov dh, 10
    mov dl, 12
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_objetivo
    int 21h
    
    ; Información sobre modo EGA
    mov ah, 02h
    mov dh, 13
    mov dl, 15
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_ega
    int 21h
    
    ; Esperar tecla
    mov ah, 02h
    mov dh, 16
    mov dl, 20
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_presiona
    int 21h
    
    mov ah, 07h         ; Esperar tecla sin eco
    int 21h
    
    ret

mensaje_presiona db 'Presiona cualquier tecla para comenzar...$'
mensaje_ega db 'Modo EGA 640x350, 16 colores activado$'
show_intro endp

init_ega_mode proc
    ; Activar modo gráfico EGA 640x350, 16 colores
    mov ax, 0010h       ; Modo EGA 10h (640x350, 16 colores)
    int 10h
    
    ; Configurar paleta EGA estándar
    call setup_ega_palette
    ret
init_ega_mode endp

setup_ega_palette proc
    push ax
    push bx
    push cx
    
    ; Configurar paleta EGA estándar de 16 colores
    mov ax, 1000h       ; Función para establecer color de paleta
    mov bx, 0000h       ; Color 0 = Negro
    int 10h
    
    mov bx, 0001h       ; Color 1 = Azul
    int 10h
    
    mov bx, 0002h       ; Color 2 = Verde
    int 10h
    
    mov bx, 0003h       ; Color 3 = Cyan
    int 10h
    
    mov bx, 0004h       ; Color 4 = Rojo
    int 10h
    
    mov bx, 0005h       ; Color 5 = Magenta
    int 10h
    
    mov bx, 0006h       ; Color 6 = Marrón
    int 10h
    
    mov bx, 0007h       ; Color 7 = Blanco/Gris claro
    int 10h
    
    mov bx, 0008h       ; Color 8 = Gris oscuro
    int 10h
    
    mov bx, 0009h       ; Color 9 = Azul claro
    int 10h
    
    mov bx, 000Ah       ; Color 10 = Verde claro
    int 10h
    
    mov bx, 000Bh       ; Color 11 = Cyan claro
    int 10h
    
    mov bx, 000Ch       ; Color 12 = Rojo claro
    int 10h
    
    mov bx, 000Dh       ; Color 13 = Magenta claro
    int 10h
    
    mov bx, 000Eh       ; Color 14 = Amarillo
    int 10h
    
    mov bx, 000Fh       ; Color 15 = Blanco brillante
    int 10h
    
    pop cx
    pop bx
    pop ax
    ret
setup_ega_palette endp

allocate_buffer proc
    push ax
    push bx
    
    ; Asignar memoria para el buffer oculto
    mov ah, 48h         ; Función DOS para asignar memoria
    mov bx, (buffer_size + 15) / 16  ; Convertir bytes a párrafos
    int 21h
    
    jc allocation_failed
    mov word ptr [buffer_segment], ax
    jmp allocation_success
    
allocation_failed:
    ; Si falla, usar segmento de video directamente (sin doble buffer)
    mov word ptr [buffer_segment], 0A000h
    
allocation_success:
    pop bx
    pop ax
    ret
allocate_buffer endp

deallocate_buffer proc
    push ax
    push es
    
    ; Liberar memoria del buffer si fue asignada
    cmp word ptr [buffer_segment], 0A000h
    je no_deallocation
    
    mov es, word ptr [buffer_segment]
    mov ah, 49h         ; Función DOS para liberar memoria
    int 21h
    
no_deallocation:
    pop es
    pop ax
    ret
deallocate_buffer endp

update_camera proc
    push ax
    push bx
    
    ; Centrar cámara en el jugador
    mov al, byte ptr [px]
    cmp al, VIEWPORT_TILES_X_HALF
    jl camera_x_min
    sub al, VIEWPORT_TILES_X_HALF
    jmp camera_x_check_max
camera_x_min:
    mov al, 0
camera_x_check_max:
    mov bl, MAPA_ANCHO - VIEWPORT_TILES_X
    cmp al, bl
    jle camera_x_valid
    mov al, bl
camera_x_valid:
    mov byte ptr [camera_x], al
    
    ; Centrar cámara en Y
    mov al, byte ptr [py]
    cmp al, VIEWPORT_TILES_Y_HALF
    jl camera_y_min
    sub al, VIEWPORT_TILES_Y_HALF
    jmp camera_y_check_max
camera_y_min:
    mov al, 0
camera_y_check_max:
    mov bl, MAPA_ALTO - VIEWPORT_TILES_Y
    cmp al, bl
    jle camera_y_valid
    mov al, bl
camera_y_valid:
    mov byte ptr [camera_y], al
    
    pop bx
    pop ax
    ret
update_camera endp

clear_and_draw_buffered proc
    ; Dibujar todo en el buffer oculto y luego transferir a pantalla
    call clear_buffer
    call draw_hud_to_buffer
    call draw_viewport_to_buffer
    call draw_player_to_buffer
    call draw_status_to_buffer
    call copy_buffer_to_screen
    ret
clear_and_draw_buffered endp

clear_buffer proc
    push ax
    push cx
    push di
    push es
    
    ; Limpiar buffer oculto
    mov es, word ptr [buffer_segment]
    mov di, 0
    mov cx, buffer_size / 2  ; Limpiar por words
    mov ax, 0
    rep stosw
    
    pop es
    pop di
    pop cx
    pop ax
    ret
clear_buffer endp

copy_buffer_to_screen proc
    push ax
    push cx
    push si
    push di
    push ds
    push es
    
    ; Verificar si tenemos buffer separado
    cmp word ptr [buffer_segment], 0A000h
    je no_copy_needed
    
    ; Copiar buffer oculto a memoria de video
    mov ds, word ptr [buffer_segment]
    mov si, 0
    mov ax, 0A000h
    mov es, ax
    mov di, 0
    mov cx, buffer_size / 2
    rep movsw
    
    ; Restaurar DS
    mov ax, @data
    mov ds, ax
    
no_copy_needed:
    pop es
    pop ds
    pop di
    pop si
    pop cx
    pop ax
    ret
copy_buffer_to_screen endp

draw_hud_to_buffer proc
    push ax
    push bx
    push cx
    push dx
    
    ; Dibujar barra del HUD en el buffer
    mov dx, 0
hud_loop:
    mov cx, 0
hud_col:
    mov al, 1           ; Azul oscuro para HUD
    call put_pixel_buffer
    inc cx
    cmp cx, 640         ; Ancho EGA
    jl hud_col
    inc dx
    cmp dx, 25          ; Altura del HUD ajustada para EGA
    jl hud_loop
    
    ; Mostrar contadores
    mov cx, 20
    mov dx, 8
    mov al, byte ptr [gold_count]
    add al, 30h
    call draw_hud_char_buffer
    
    mov cx, 60
    mov dx, 8
    mov al, '/'
    call draw_hud_char_buffer
    
    mov cx, 80
    mov dx, 8
    mov al, byte ptr [gold_needed]
    add al, 30h
    call draw_hud_char_buffer
    
    mov cx, 160
    mov dx, 8
    mov al, byte ptr [crystals_count]
    add al, 30h
    call draw_hud_char_buffer
    
    mov cx, 200
    mov dx, 8
    mov al, '/'
    call draw_hud_char_buffer
    
    mov cx, 220
    mov dx, 8
    mov al, byte ptr [crystals_needed]
    add al, 30h
    call draw_hud_char_buffer
    
    mov cx, 300
    mov dx, 8
    mov al, byte ptr [treasures_count]
    add al, 30h
    call draw_hud_char_buffer
    
    mov cx, 340
    mov dx, 8
    mov al, '/'
    call draw_hud_char_buffer
    
    mov cx, 360
    mov dx, 8
    mov al, byte ptr [treasures_needed]
    add al, 30h
    call draw_hud_char_buffer
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_hud_to_buffer endp

draw_hud_char_buffer proc
    ; AL = carácter ASCII, CX,DX = posición
    push ax
    push bx
    push si
    
    ; Dibujar carácter en buffer
    mov bx, 0
char_y_buf:
    mov si, 0
char_x_buf:
    push cx
    push dx
    mov al, 15          ; Blanco brillante
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl char_x_buf
    inc bx
    cmp bx, 16
    jl char_y_buf
    
    pop si
    pop bx
    pop ax
    ret
draw_hud_char_buffer endp

put_pixel_buffer proc
    ; CX = X, DX = Y, AL = color
    ; Dibujar pixel en el buffer (simplificado para EGA)
    push ax
    push bx
    push cx
    push dx
    push es
    
    mov es, word ptr [buffer_segment]
    
    ; Cálculo simplificado para EGA mode 10h
    ; Posición = (Y * 80) + (X / 8)
    mov ax, dx
    mov bx, 80
    mul bx
    mov bx, cx
    shr bx, 3           ; Dividir X por 8
    add ax, bx
    mov bx, ax
    
    ; Escribir pixel (simplificado)
    mov al, 15          ; Color blanco por defecto
    mov byte ptr es:[bx], al
    
    pop es
    pop dx
    pop cx
    pop bx
    pop ax
    ret
put_pixel_buffer endp

draw_viewport_to_buffer proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    mov si, 0           ; Contador Y del viewport

viewport_y_loop_buf:
    mov di, 0           ; Contador X del viewport

viewport_x_loop_buf:
    ; Calcular posición Y en el mapa
    mov al, byte ptr [camera_y]
    mov ah, 0
    add ax, si          ; camera_y + viewport_y
    
    ; Calcular posición X en el mapa  
    mov bl, byte ptr [camera_x]
    mov bh, 0
    add bx, di          ; camera_x + viewport_x
    
    ; Calcular índice del mapa: Y * MAPA_ANCHO + X
    push bx             ; Guardar X
    mov dx, MAPA_ANCHO
    mul dx              ; AX = Y * MAPA_ANCHO
    pop bx              ; Recuperar X
    add ax, bx          ; AX = Y * MAPA_ANCHO + X
    mov bx, ax          ; BX = índice del mapa
    
    ; Verificar límites del mapa
    cmp bx, 300         ; 20*15 = 300 tiles máximo
    jge skip_current_tile_buf
    
    ; Obtener tile del mapa
    mov al, byte ptr [mapa + bx]
    
    ; Calcular posición en pantalla
    push ax             ; Guardar tipo de tile
    
    ; X en pantalla = di * TILE_SIZE * 2 (escalar para EGA)
    mov ax, di
    mov dx, TILE_SIZE
    mul dx
    shl ax, 1           ; Multiplicar por 2 para EGA
    mov cx, ax          ; CX = X en pantalla
    
    ; Y en pantalla = si * TILE_SIZE + 30 (offset HUD para EGA)
    mov ax, si
    mov dx, TILE_SIZE
    mul dx
    add ax, 30          ; Offset para HUD en EGA
    mov dx, ax          ; DX = Y en pantalla
    
    ; Verificar si está dentro del viewport visible
    cmp cx, 320         ; Límite derecho del viewport para EGA
    jge skip_tile_draw_buf
    cmp dx, 130         ; Límite inferior del viewport
    jge skip_tile_draw_buf
    
    pop ax              ; Recuperar tipo de tile
    call draw_tile_buffer
    jmp continue_loop_buf

skip_tile_draw_buf:
    pop ax              ; Limpiar stack
    jmp continue_loop_buf

skip_current_tile_buf:
    ; No hay nada que limpiar del stack aquí

continue_loop_buf:
    inc di
    cmp di, VIEWPORT_TILES_X
    jl viewport_x_loop_buf
    
    inc si
    cmp si, VIEWPORT_TILES_Y
    jl viewport_y_loop_buf
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_viewport_to_buffer endp

draw_tile_buffer proc
    ; AL = tipo de tile, CX,DX = posición
    push cx
    push dx
    
    cmp al, '#'
    je tile_wall_buf
    cmp al, '~'
    je tile_water_buf
    cmp al, 'G'
    je tile_gold_buf
    cmp al, 'C'
    je tile_crystal_buf
    cmp al, 'T'
    je tile_treasure_buf
    cmp al, 'O'
    je tile_pit_buf
    cmp al, '+'    
    je tile_path_buf
    cmp al, 'E'
    je tile_exit_buf
    cmp al, '.'    
    je tile_floor_buf
    
    ; Default - suelo de piedra
    mov al, 7           ; Gris claro
    call draw_simple_tile_buffer
    pop dx
    pop cx
    ret

tile_wall_buf:
    mov al, 8           ; Gris medio
    call draw_simple_tile_buffer
    call draw_wall_effects_buffer
    pop dx
    pop cx
    ret

tile_water_buf:
    mov al, 1           ; Azul
    call draw_simple_tile_buffer
    call draw_water_effects_buffer
    pop dx
    pop cx
    ret

tile_path_buf:
    mov al, 14          ; Amarillo brillante
    call draw_simple_tile_buffer
    pop dx
    pop cx
    ret

tile_exit_buf:
    mov al, 13          ; Magenta brillante
    call draw_simple_tile_buffer
    call draw_exit_effects_buffer
    pop dx
    pop cx
    ret

tile_gold_buf:
    mov al, 6           ; Marrón oscuro de fondo
    call draw_simple_tile_buffer
    call draw_gold_item_buffer
    pop dx
    pop cx
    ret

tile_crystal_buf:
    mov al, 7           ; Gris claro de fondo
    call draw_simple_tile_buffer
    call draw_crystal_item_buffer
    pop dx
    pop cx
    ret

tile_treasure_buf:
    mov al, 7           ; Gris claro de fondo
    call draw_simple_tile_buffer
    call draw_treasure_item_buffer
    pop dx
    pop cx
    ret

tile_pit_buf:
    mov al, 0           ; Negro
    call draw_simple_tile_buffer
    call draw_pit_effects_buffer
    pop dx
    pop cx
    ret

tile_floor_buf:
    mov al, 7           ; Gris claro
    call draw_simple_tile_buffer
    pop dx
    pop cx
    ret
draw_tile_buffer endp

draw_simple_tile_buffer proc
    push ax
    push bx
    push si
    
    mov bx, 0
tile_row_buf:
    mov si, 0
tile_col_buf:
    push ax
    push cx
    push dx
    add dx, bx
    add cx, si
    call put_pixel_buffer
    pop dx
    pop cx
    pop ax
    
    inc si
    cmp si, TILE_SIZE * 2  ; Escalar para EGA
    jl tile_col_buf
    inc bx
    cmp bx, TILE_SIZE
    jl tile_row_buf
    
    pop si
    pop bx
    pop ax
    ret
draw_simple_tile_buffer endp

draw_wall_effects_buffer proc
    push ax
    push bx
    push si
    
    ; Borde superior e izquierdo más claro
    mov bx, 0
wall_effect_y_buf:
    mov si, 0
wall_effect_x_buf:
    push cx
    push dx
    mov al, 15          ; Blanco para resaltar
    add cx, si
    add dx, bx
    cmp bx, 1
    jle wall_bright_buf
    cmp si, 1
    jle wall_bright_buf
    jmp wall_effect_skip_buf
wall_bright_buf:
    call put_pixel_buffer
wall_effect_skip_buf:
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl wall_effect_x_buf
    inc bx
    cmp bx, TILE_SIZE
    jl wall_effect_y_buf
    
    pop si
    pop bx
    pop ax
    ret
draw_wall_effects_buffer endp

draw_water_effects_buffer proc
    push ax
    push bx
    push si
    
    ; Ondas más visibles
    mov bx, 4
    mov si, 4
    push cx
    push dx
    mov al, 9           ; Azul claro
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    
    mov bx, 8
    mov si, 8
    push cx
    push dx
    mov al, 11          ; Cyan brillante
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    
    pop si
    pop bx
    pop ax
    ret
draw_water_effects_buffer endp

draw_exit_effects_buffer proc
    push ax
    push bx
    push si
    
    ; Cruz brillante en el centro
    mov bx, 8
    mov si, 4
exit_horizontal_buf:
    push cx
    push dx
    mov al, 15          ; Blanco brillante
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl exit_horizontal_buf
    
    mov bx, 4
    mov si, 8
exit_vertical_buf:
    push cx
    push dx
    mov al, 15
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc bx
    cmp bx, 12
    jl exit_vertical_buf
    
    pop si
    pop bx
    pop ax
    ret
draw_exit_effects_buffer endp

draw_pit_effects_buffer proc
    push ax
    push bx
    push si
    
    ; Borde gris alrededor del pozo para buffer
    mov bx, 0
pit_border_y_buf:
    mov si, 0
pit_border_x_buf:
    push cx
    push dx
    mov al, 8           ; Gris
    ; Solo dibujar en los bordes
    cmp bx, 2
    jl pit_border_draw_buf
    cmp bx, 14
    jg pit_border_draw_buf
    cmp si, 2
    jl pit_border_draw_buf
    cmp si, 14
    jg pit_border_draw_buf
    jmp pit_border_skip_buf
    
pit_border_draw_buf:
    add cx, si
    add dx, bx
    call put_pixel_buffer
    
pit_border_skip_buf:
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE * 2  ; Escalar para EGA
    jl pit_border_x_buf
    inc bx
    cmp bx, TILE_SIZE
    jl pit_border_y_buf
    
    pop si
    pop bx
    pop ax
    ret
draw_pit_effects_buffer endp

draw_gold_item_buffer proc
    push ax
    push bx
    push si
    
    ; Círculo dorado en el centro
    mov bx, 6
gold_center_y_buf:
    mov si, 6
gold_center_x_buf:
    push cx
    push dx
    mov al, 14          ; Amarillo brillante
    add cx, si
    add dx, bx
    call put_pixel_buffer
    pop dx
    pop cx
    inc si
