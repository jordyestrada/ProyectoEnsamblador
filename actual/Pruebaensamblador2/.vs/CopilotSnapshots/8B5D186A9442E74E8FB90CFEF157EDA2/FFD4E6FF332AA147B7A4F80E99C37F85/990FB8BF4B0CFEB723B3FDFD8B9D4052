draw_crystal_gem_simple endp

draw_treasure_chest_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cofre pequeño simplificado
    mov di, 5
chest_y:
    mov si, 5
chest_x:
    push cx
    push dx
    
    mov ah, 0Ch
    cmp di, 8
    jl chest_lid
    cmp si, 6
    jl chest_skip
    cmp si, 10
    jg chest_skip
    mov al, 6          ; Marrón para base
    jmp chest_draw
    
chest_lid:
    cmp si, 5
    jl chest_skip
    cmp si, 11
    jg chest_skip
    mov al, 14         ; Dorado para tapa
    ; Brillo en cerradura
    cmp si, 8
    jne chest_draw
    cmp di, 6
    jne chest_draw
    mov al, 15         ; Brillo
    
chest_draw:
    add cx, si
    add dx, di
    int 10h
    
chest_skip:
    pop dx
