.model small
.stack 100h

.data
    ; Mapa expandido a 20x15 tiles (requisito mínimo)
    mapa db '####################'
         db '#.GTCGT..#.GTCGT..#'
         db '#..++~+C.#..++~+C.#'
         db '#.T++~++T#.T++~++T#'
         db '#G.++O+.G#G.++O+.G#'
         db '#..T++TC.#..T++TC.#'
         db '#..++..E.#..++....#'
         db '####################'
         db '#GTCGT..##..GTCGT.#'
         db '#.++~+C.##.++~+C..#'
         db '#T++~++T##T++~++T.#'
         db '#.++O+.G##G.++O+..#'
         db '#.T++TC.##..T++TC.#'
         db '#.++....##..++..E.#'
         db '####################'
    
    px db 2
    py db 6
    tecla db 0
    fin db 0
    redraw db 1
    
    ; Viewport y cámara
    camera_x db 0
    camera_y db 0
    VIEWPORT_WIDTH equ 160
    VIEWPORT_HEIGHT equ 100
    VIEWPORT_TILES_X equ 10
    VIEWPORT_TILES_Y equ 6
    VIEWPORT_TILES_X_HALF equ 5
    VIEWPORT_TILES_Y_HALF equ 3
    
    ; Sistema de inventario
    gold_count db 0
    crystals_count db 0
    treasures_count db 0
    
    ; Objetivos
    gold_needed db 2
    crystals_needed db 2
    treasures_needed db 2
    
    MAPA_ANCHO equ 20
    MAPA_ALTO equ 15
    TILE_SIZE equ 16

.code
start:
    mov ax, @data
    mov ds, ax
    
    call init_screen
    
game_loop:
    cmp byte ptr [redraw], 1
    jne skip_draw
    
    call update_camera
    call clear_and_draw
    mov byte ptr [redraw], 0

skip_draw:
    call get_key_nowait
    cmp byte ptr [tecla], 0
    je game_loop
    
    call move_player
    call check_item_collection
    call check_win
    
    cmp byte ptr [fin], 1
    jne game_loop
    
    call restore_screen
    mov ax, 4c00h
    int 21h

init_screen proc
    mov ax, 0013h
    int 10h
    ret
init_screen endp

update_camera proc
    push ax
    push bx
    
    ; Centrar cámara en el jugador
    mov al, byte ptr [px]
    sub al, VIEWPORT_TILES_X_HALF
    cmp al, 0
    jge camera_x_positive
    mov al, 0
camera_x_positive:
    mov bl, MAPA_ANCHO - VIEWPORT_TILES_X
    cmp al, bl
    jle camera_x_valid
    mov al, bl
camera_x_valid:
    mov byte ptr [camera_x], al
    
    ; Centrar cámara en Y
    mov al, byte ptr [py]
    sub al, VIEWPORT_TILES_Y_HALF
    cmp al, 0
    jge camera_y_positive
    mov al, 0
camera_y_positive:
    mov bl, MAPA_ALTO - VIEWPORT_TILES_Y
    cmp al, bl
    jle camera_y_valid
    mov al, bl
camera_y_valid:
    mov byte ptr [camera_y], al
    
    pop bx
    pop ax
    ret
update_camera endp

clear_and_draw proc
    call clear_vga_screen
    call draw_hud
    call draw_viewport
    call draw_player
    ret
clear_and_draw endp

clear_vga_screen proc
    push ax
    push cx
    push di
    push es
    
    mov ax, 0A000h
    mov es, ax
    mov di, 0
    mov cx, 32000
    mov ax, 0
    rep stosw
    
    pop es
    pop di
    pop cx
    pop ax
    ret
clear_vga_screen endp

draw_hud proc
    push ax
    push bx
    push cx
    push dx
    
    ; Dibujar barra del HUD con gradiente
    mov dx, 0
hud_loop:
    mov cx, 0
hud_col:
    mov ah, 0Ch
    mov al, 8           ; Gris oscuro base
    cmp dx, 5
    jl hud_gradient_top
    cmp dx, 15
    jl hud_gradient_mid
    mov al, 7           ; Gris más claro abajo
    jmp hud_pixel
hud_gradient_top:
    mov al, 15          ; Blanco arriba
    jmp hud_pixel
hud_gradient_mid:
    mov al, 8           ; Gris medio
hud_pixel:
    int 10h
    inc cx
    cmp cx, 160
    jl hud_col
    inc dx
    cmp dx, 20
    jl hud_loop
    
    ; Dibujar iconos simplificados
    mov cx, 5
    mov dx, 3
    call draw_gold_icon_simple
    
    mov cx, 25
    mov dx, 8
    mov al, byte ptr [gold_count]
    call draw_enhanced_number
    
    mov cx, 45
    mov dx, 3
    call draw_crystal_icon_simple
    
    mov cx, 65
    mov dx, 8
    mov al, byte ptr [crystals_count]
    call draw_enhanced_number
    
    mov cx, 85
    mov dx, 3
    call draw_treasure_icon_simple
    
    mov cx, 105
    mov dx, 8
    mov al, byte ptr [treasures_count]
    call draw_enhanced_number
    
    ; Indicador de progreso
    mov cx, 125
    mov dx, 5
    call draw_progress_indicator
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_hud endp

draw_gold_icon_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar círculo dorado simplificado usando patrones predefinidos
    mov di, 2
gold_icon_y:
    mov si, 2
gold_icon_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Usar patrón simple para círculo
    cmp di, 3
    jl gold_top_bottom
    cmp di, 8
    jg gold_top_bottom
    cmp si, 1
    jl gold_skip
    cmp si, 10
    jg gold_skip
    mov al, 14         ; Dorado
    jmp gold_draw
    
gold_top_bottom:
    cmp si, 3
    jl gold_skip
    cmp si, 8
    jg gold_skip
    mov al, 14         ; Dorado
    jmp gold_draw
    
gold_draw:
    ; Centro brillante
    cmp di, 5
    jne gold_normal
    cmp si, 5
    jne gold_normal
    mov al, 15         ; Brillo central
gold_normal:
    add cx, si
    add dx, di
    int 10h
    
gold_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl gold_icon_x
    inc di
    cmp di, 12
    jl gold_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_gold_icon_simple endp

draw_crystal_icon_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar diamante simplificado
    mov di, 1
crystal_icon_y:
    mov si, 1
crystal_icon_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Forma de diamante usando líneas
    mov al, si
    add al, di
    cmp al, 6
    jl crystal_skip
    cmp al, 12
    jg crystal_skip
    
    mov bl, si
    sub bl, di
    add bl, 6
    cmp bl, 0
    jl crystal_skip
    cmp bl, 12
    jg crystal_skip
    
    mov al, 3          ; Cyan
    ; Alternado para efecto
    test si, 1
    jz crystal_draw
    mov al, 11         ; Cyan brillante
    
crystal_draw:
    add cx, si
    add dx, di
    int 10h
    
crystal_skip:
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl crystal_icon_x
    inc di
    cmp di, 11
    jl crystal_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_crystal_icon_simple endp

draw_treasure_icon_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cofre simplificado
    mov di, 1
treasure_icon_y:
    mov si, 1
treasure_icon_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Base del cofre
    cmp di, 7
    jl treasure_top
    cmp si, 2
    jl treasure_skip
    cmp si, 9
    jg treasure_skip
    mov al, 6          ; Marrón para base
    jmp treasure_draw
    
treasure_top:
    cmp di, 2
    jl treasure_lid
    cmp si, 2
    jl treasure_skip
    cmp si, 9
    jg treasure_skip
    mov al, 4          ; Rojo para cuerpo
    jmp treasure_draw
    
treasure_lid:
    cmp si, 1
    jl treasure_skip
    cmp si, 10
    jg treasure_skip
    mov al, 14         ; Dorado para tapa
    
treasure_draw:
    add cx, si
    add dx, di
    int 10h
    
treasure_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl treasure_icon_x
    inc di
    cmp di, 11
    jl treasure_icon_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_treasure_icon_simple endp

draw_enhanced_number proc
    push ax
    push bx
    push si
    push di
    
    ; Convertir número a dígito visual mejorado
    add al, 30h        ; Convertir a ASCII
    
    mov di, 0
number_y:
    mov si, 0
number_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 15         ; Blanco brillante
    add cx, si
    add dx, di
    int 10h
    
    ; Sombra
    push cx
    push dx
    inc cx
    inc dx
    mov al, 8          ; Gris para sombra
    int 10h
    pop dx
    pop cx
    
    pop dx
    pop cx
    inc si
    cmp si, 8
    jl number_x
    inc di
    cmp di, 10
    jl number_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_enhanced_number endp

draw_progress_indicator proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Verificar progreso total
    mov al, byte ptr [gold_count]
    mov bl, byte ptr [crystals_count]
    add al, bl
    mov bl, byte ptr [treasures_count]
    add al, bl
    
    ; Dibujar barra de progreso
    mov si, 0
progress_bar:
    push cx
    push dx
    
    mov ah, 0Ch
    cmp si, al
    jl progress_filled
    mov al, 8          ; Vacío
    jmp progress_draw
progress_filled:
    mov al, 10         ; Verde lleno
progress_draw:
    add cx, si
    int 10h
    inc dx
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, 20
    jl progress_bar
    
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_progress_indicator endp

draw_viewport proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    mov bl, byte ptr [camera_y]
    mov si, 0

viewport_y_loop:
    mov cl, byte ptr [camera_x]
    mov di, 0

viewport_x_loop:
    ; Calcular posición en el mapa
    push si
    push di
    mov al, bl
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, cl
    mov dh, 0
    add ax, dx
    mov si, ax
    
    ; Obtener tile del mapa
    mov al, byte ptr [mapa + si]
    
    ; Calcular posición en pantalla
    pop di
    pop si
    push ax
    mov al, dl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, bl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20
    mov dx, ax
    pop ax
    
    ; Dibujar tile mejorado
    call draw_enhanced_tile
    
    inc di
    inc cl
    cmp di, VIEWPORT_TILES_X
    jl viewport_x_loop
    
    inc si
    inc bl
    cmp si, VIEWPORT_TILES_Y
    jl viewport_y_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_viewport endp

draw_enhanced_tile proc
    ; AL = tipo de tile, CX,DX = posición
    push cx
    push dx
    
    cmp al, '#'
    je enhanced_wall
    cmp al, '~'
    je enhanced_water
    cmp al, 'G'
    je enhanced_gold
    cmp al, 'C'
    je enhanced_crystal
    cmp al, 'T'
    je enhanced_treasure
    cmp al, 'O'
    je enhanced_pit
    cmp al, '+'
    je enhanced_path
    cmp al, 'E'
    je enhanced_exit
    cmp al, '.'
    je enhanced_floor
    
    ; Default
    call draw_simple_tile_black
    pop dx
    pop cx
    ret

enhanced_wall:
    call draw_stone_wall
    pop dx
    pop cx
    ret

enhanced_water:
    call draw_water_waves
    pop dx
    pop cx
    ret

enhanced_path:
    call draw_stone_path
    pop dx
    pop cx
    ret

enhanced_exit:
    call draw_magical_exit
    pop dx
    pop cx
    ret

enhanced_gold:
    call draw_stone_path
    call draw_gold_coin_simple
    pop dx
    pop cx
    ret

enhanced_crystal:
    call draw_stone_path
    call draw_crystal_gem_simple
    pop dx
    pop cx
    ret

enhanced_treasure:
    call draw_stone_path
    call draw_treasure_chest_simple
    pop dx
    pop cx
    ret

enhanced_pit:
    call draw_deep_hole_simple
    pop dx
    pop cx
    ret

enhanced_floor:
    call draw_stone_floor
    pop dx
    pop cx
    ret
draw_enhanced_tile endp

draw_stone_wall proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
wall_y:
    mov si, 0
wall_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Efecto de piedra con bloques
    mov al, 7          ; Gris base
    
    ; Líneas de mortero
    mov bl, di
    and bl, 7
    cmp bl, 0
    je wall_mortar
    mov bl, si
    and bl, 7
    cmp bl, 0
    je wall_mortar
    
    ; Variaciones en la piedra
    mov bl, di
    add bl, si
    and bl, 3
    cmp bl, 0
    jne wall_normal
    mov al, 8          ; Más oscuro
    jmp wall_draw
    
wall_mortar:
    mov al, 15         ; Mortero claro
    jmp wall_draw
    
wall_normal:
    ; Sombras y luces
    cmp di, 2
    jl wall_highlight
    cmp si, 2
    jl wall_highlight
    jmp wall_draw
    
wall_highlight:
    mov al, 15
    
wall_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl wall_x
    inc di
    cmp di, TILE_SIZE
    jl wall_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_wall endp

draw_water_waves proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
water_y:
    mov si, 0
water_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 1          ; Azul base
    
    ; Crear ondas animadas
    mov bl, si
    add bl, di
    and bl, 7
    cmp bl, 0
    jne water_normal
    mov al, 9          ; Azul claro para ondas
    jmp water_draw
    
water_normal:
    and bl, 3
    cmp bl, 1
    jne water_draw
    mov al, 3          ; Cyan para reflejos
    
water_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl water_x
    inc di
    cmp di, TILE_SIZE
    jl water_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_water_waves endp

draw_stone_path proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
path_y:
    mov si, 0
path_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 14         ; Amarillo base
    
    ; Textura de adoquines
    mov bl, si
    and bl, 7
    mov bh, di
    and bh, 7
    
    cmp bl, 0
    je path_seam
    cmp bh, 0
    je path_seam
    
    ; Variación en color
    add bl, bh
    and bl, 3
    cmp bl, 1
    jne path_draw
    mov al, 6          ; Marrón para variación
    jmp path_draw
    
path_seam:
    mov al, 8          ; Gris para juntas
    
path_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl path_x
    inc di
    cmp di, TILE_SIZE
    jl path_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_path endp

draw_stone_floor proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
floor_y:
    mov si, 0
floor_x:
    push cx
    push dx
    
    mov ah, 0Ch
    mov al, 8          ; Gris oscuro base
    
    ; Patrón de piedra simple
    mov bl, si
    add bl, di
    and bl, 15
    cmp bl, 0
    jne floor_draw
    mov al, 7          ; Más claro ocasionalmente
    
floor_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl floor_x
    inc di
    cmp di, TILE_SIZE
    jl floor_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_stone_floor endp

draw_gold_coin_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar moneda dorada usando patrón simple
    mov di, 4
coin_y:
    mov si, 4
coin_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Patrón simple de círculo
    cmp di, 6
    jl coin_top_bottom
    cmp di, 10
    jg coin_top_bottom
    cmp si, 3
    jl coin_skip
    cmp si, 13
    jg coin_skip
    mov al, 14         ; Dorado
    jmp coin_draw
    
coin_top_bottom:
    cmp si, 5
    jl coin_skip
    cmp si, 11
    jg coin_skip
    mov al, 14         ; Dorado
    
coin_draw:
    ; Centro brillante
    cmp di, 8
    jne coin_normal
    cmp si, 8
    jne coin_normal
    mov al, 15         ; Brillo central
coin_normal:
    add cx, si
    add dx, di
    int 10h
    
coin_skip:
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl coin_x
    inc di
    cmp di, 12
    jl coin_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_gold_coin_simple endp

draw_crystal_gem_simple proc
    push ax
    push bx
    push si
    push di
    
    ; Dibujar cristal simplificado
    mov di, 5
gem_y:
    mov si, 5
gem_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Forma de diamante simple
    mov al, si
    add al, di
    cmp al, 10
    jl gem_skip
    cmp al, 16
    jg gem_skip
    
    mov bl, si
    sub bl, di
    add bl, 8
    cmp bl, 2
    jl gem_skip
    cmp bl, 14
    jg gem_skip
    
    mov al, 3          ; Cyan
    test di, 1
    jz gem_draw
    mov al, 11         ; Cyan brillante
    
gem_draw:
    add cx, si
    add dx, di
    int 10h
    
gem_skip:
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl gem_x
    inc di
    cmp di, 11
    jl gem_y
    
    pop di
    pop si
    pop bx
    pop ax
