draw_deep_hole_simple proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
hole_y:
    mov si, 0
hole_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Patrón simple de agujero
    cmp di, 3
    jl hole_edge
    cmp di, 13
    jg hole_edge
    cmp si, 3
    jl hole_edge
    cmp si, 13
    jg hole_edge
    
    ; Centro
    cmp di, 6
    jl hole_shadow
    cmp di, 10
    jg hole_shadow
    cmp si, 6
    jl hole_shadow
    cmp si, 10
    jg hole_shadow
    mov al, 0          ; Negro profundo
    jmp hole_draw
    
hole_shadow:
    mov al, 8          ; Gris para sombra
    jmp hole_draw
    
hole_edge:
    mov al, 6          ; Marrón para borde
    
hole_draw:
    add cx, si
    add dx, di
    int 10h
    
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl hole_x
    inc di
    cmp di, TILE_SIZE
    jl hole_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_deep_hole_simple endp

draw_magical_exit proc
    push ax
    push bx
    push si
    push di
    
    mov di, 0
exit_y:
    mov si, 0
exit_x:
    push cx
    push dx
    
    mov ah, 0Ch
    ; Portal mágico simplificado con anillos
    cmp di, 2
    jl exit_skip
    cmp di, 14
    jg exit_skip
    cmp si, 2
    jl exit_skip
    cmp si, 14
    jg exit_skip
    
    ; Anillo exterior
    cmp di, 4
    jl exit_outer
    cmp di, 12
    jg exit_outer
    cmp si, 4
    jl exit_outer
    cmp si, 12
    jg exit_outer
    
    ; Anillo medio
    cmp di, 6
    jl exit_middle
    cmp di, 10
    jg exit_middle
    cmp si, 6
    jl exit_middle
    cmp si, 10
    jg exit_middle
    
    ; Centro
    mov al, 15         ; Centro brillante
    jmp exit_draw
    
exit_middle:
    mov al, 13         ; Magenta brillante
    jmp exit_draw
    
exit_outer:
    mov al, 5          ; Magenta
    jmp exit_draw
    
exit_draw:
    add cx, si
    add dx, di
    int 10h
    
exit_skip:
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl exit_x
    inc di
    cmp di, TILE_SIZE
    jl exit_y
    
    pop di
    pop si
    pop bx
    pop ax
    ret
draw_magical_exit endp

draw_simple_tile_black proc
    push ax
    push bx
    push si
    
    mov bx, 0
black_tile_row:
    mov si, 0
black_tile_col:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 0
    add dx, bx
    add cx, si
    int 10h
    pop dx
    pop cx
    
    inc si
    cmp si, TILE_SIZE
    jl black_tile_col
    inc bx
    cmp bx, TILE_SIZE
    jl black_tile_row
    
    pop si
    pop bx
    pop ax
    ret
draw_simple_tile_black endp

draw_player proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    ; Calcular posición del jugador en viewport
    mov al, byte ptr [px]
    sub al, byte ptr [camera_x]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, byte ptr [py]
    sub al, byte ptr [camera_y]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20
    mov dx, ax
    
