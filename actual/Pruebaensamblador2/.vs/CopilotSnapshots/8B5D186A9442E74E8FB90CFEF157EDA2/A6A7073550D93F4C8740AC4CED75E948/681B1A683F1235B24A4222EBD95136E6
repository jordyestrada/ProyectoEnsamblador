    pop si
    pop bx
    pop ax
    ret
draw_simple_number endp

draw_status proc
    ; Mostrar estado del juego en la parte inferior
    push ax
    push bx
    push cx
    push dx
    
    ; Verificar si el jugador ha completado los objetivos
    mov al, byte ptr [gold_count]
    cmp al, byte ptr [gold_needed]
    jl status_incomplete
    mov al, byte ptr [crystals_count]
    cmp al, byte ptr [crystals_needed]
    jl status_incomplete
    mov al, byte ptr [treasures_count]
    cmp al, byte ptr [treasures_needed]
    jl status_incomplete
    
    ; Mostrar mensaje de "¡Ve a la salida!"
    mov cx, 80
    mov dx, 180
    call draw_exit_message
    jmp status_end
    
status_incomplete:
    ; Mostrar mensaje de "Busca más tesoros"
    mov cx, 80
    mov dx, 180
    call draw_search_message

status_end:
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_status endp

draw_exit_message proc
    push ax
    push bx
    push si
    
    ; Mensaje "¡VE A LA SALIDA!" en verde brillante
    mov bx, 0
exit_msg_y:
