draw_search_message endp

draw_viewport proc
    push ax
    push bx
    push cx
    push dx
    push si
    push di
    
    mov bl, byte ptr [camera_y]
    mov si, 0

viewport_y_loop:
    mov cl, byte ptr [camera_x]
    mov di, 0

viewport_x_loop:
    ; Calcular posición en el mapa
    push si
    push di
    mov al, bl
    mov ah, 0
    mov dx, MAPA_ANCHO
    mul dx
    mov dl, cl
    mov dh, 0
    add ax, dx
    mov si, ax
    
    ; Verificar límites del mapa
    cmp si, 300         ; 20*15 = 300 tiles máximo
    jge skip_tile
    
    ; Obtener tile del mapa
    mov al, byte ptr [mapa + si]
    
    ; Calcular posición en pantalla
    pop di
    pop si
    push ax
    mov al, dl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, bl
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20          ; Offset para HUD
    mov dx, ax
    pop ax
    
    ; Dibujar tile solo si está en el viewport
    cmp cx, 160         ; Límite derecho del viewport
    jg skip_tile_draw
    cmp dx, 116         ; Límite inferior del viewport (20+96)
    jg skip_tile_draw
    
    call draw_tile
    jmp continue_tile

skip_tile_draw:
skip_tile:
    pop di
    pop si

continue_tile:
    inc di
    inc cl
    cmp di, VIEWPORT_TILES_X
    jl viewport_x_loop
    
    inc si
    inc bl
    cmp si, VIEWPORT_TILES_Y
    jl viewport_y_loop
    
    pop di
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_viewport endp

draw_tile proc
    ; AL = tipo de tile, CX,DX = posición
    push cx
    push dx
    
    cmp al, '#'
    je tile_wall
    cmp al, '~'
    je tile_water
    cmp al, 'G'
    je tile_gold
    cmp al, 'C'
    je tile_crystal
    cmp al, 'T'
    je tile_treasure
    cmp al, 'O'
    je tile_pit
    cmp al, '+'    
    je tile_path
    cmp al, 'E'
    je tile_exit
    cmp al, '.'    
    je tile_floor
    
    ; Default - suelo de piedra
    mov al, 7           ; Gris claro
    call draw_simple_tile
    pop dx
    pop cx
    ret

tile_wall:
    mov al, 8           ; Gris medio
    call draw_simple_tile
    call draw_wall_effects
    pop dx
    pop cx
    ret

tile_water:
    mov al, 1           ; Azul
    call draw_simple_tile
    call draw_water_effects
    pop dx
    pop cx
    ret

tile_path:
    mov al, 14          ; Amarillo brillante
    call draw_simple_tile
    pop dx
    pop cx
    ret

tile_exit:
    mov al, 13          ; Magenta brillante
    call draw_simple_tile
    call draw_exit_effects
    pop dx
    pop cx
    ret

tile_gold:
    mov al, 6           ; Marrón oscuro de fondo
    call draw_simple_tile
    call draw_gold_item
    pop dx
    pop cx
    ret

tile_crystal:
    mov al, 7           ; Gris claro de fondo
    call draw_simple_tile
    call draw_crystal_item
    pop dx
    pop cx
    ret

tile_treasure:
    mov al, 7           ; Gris claro de fondo
    call draw_simple_tile
    call draw_treasure_item
    pop dx
    pop cx
    ret

tile_pit:
    mov al, 0           ; Negro
    call draw_simple_tile
    call draw_pit_effects
    pop dx
    pop cx
    ret

tile_floor:
    mov al, 7           ; Gris claro
    call draw_simple_tile
    pop dx
    pop cx
    ret
draw_tile endp

draw_simple_tile proc
    push ax
    push bx
    push si
    
    mov bx, 0
tile_row:
    mov si, 0
tile_col:
    push ax
    push cx
    push dx
    mov ah, 0Ch
    add dx, bx
    add cx, si
    int 10h
    pop dx
    pop cx
    pop ax
    
    inc si
    cmp si, TILE_SIZE
    jl tile_col
    inc bx
    cmp bx, TILE_SIZE
    jl tile_row
    
    pop si
    pop bx
    pop ax
    ret
draw_simple_tile endp

draw_wall_effects proc
    push ax
    push bx
    push si
    
    ; Borde superior e izquierdo más claro
    mov bx, 0
wall_effect_y:
    mov si, 0
wall_effect_x:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 15          ; Blanco para resaltar
    add cx, si
    add dx, bx
    cmp bx, 1
    jle wall_bright
    cmp si, 1
    jle wall_bright
    jmp wall_effect_skip
wall_bright:
    int 10h
wall_effect_skip:
    pop dx
    pop cx
    inc si
    cmp si, TILE_SIZE
    jl wall_effect_x
    inc bx
    cmp bx, TILE_SIZE
    jl wall_effect_y
    
    pop si
    pop bx
    pop ax
    ret
draw_wall_effects endp

draw_water_effects proc
    push ax
    push bx
    push si
    
    ; Ondas más visibles
    mov bx, 4
water_wave1:
    mov si, 4
    push cx
    push dx
    mov ah, 0Ch
    mov al, 9           ; Azul claro
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    
    mov bx, 8
    mov si, 8
    push cx
    push dx
    mov ah, 0Ch
    mov al, 11          ; Cyan brillante
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    
    pop si
    pop bx
    pop ax
    ret
draw_water_effects endp

draw_exit_effects proc
    push ax
    push bx
    push si
    
    ; Cruz brillante en el centro
    mov bx, 8
    mov si, 4
exit_horizontal:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 15          ; Blanco brillante
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl exit_horizontal
    
    mov bx, 4
    mov si, 8
exit_vertical:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 15
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc bx
    cmp bx, 12
    jl exit_vertical
    
    pop si
    pop bx
    pop ax
    ret
draw_exit_effects endp

