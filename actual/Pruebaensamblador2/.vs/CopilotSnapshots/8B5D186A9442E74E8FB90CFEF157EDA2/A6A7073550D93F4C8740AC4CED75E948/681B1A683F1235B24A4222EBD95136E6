.model small
.stack 100h

.data
    ; Mapa expandido a 20x15 tiles (requisito mínimo)
    mapa db '####################'
         db '#.GTCGT..#.GTCGT..#'
         db '#..++~+C.#..++~+C.#'
         db '#.T++~++T#.T++~++T#'
         db '#G.++O+.G#G.++O+.G#'
         db '#..T++TC.#..T++TC.#'
         db '#..++..E.#..++....#'
         db '####################'
         db '#GTCGT..##..GTCGT.#'
         db '#.++~+C.##.++~+C..#'
         db '#T++~++T##T++~++T.#'
         db '#.++O+.G##G.++O+..#'
         db '#.T++TC.##..T++TC.#'
         db '#.++....##..++..E.#'
         db '####################'
    
    px db 2
    py db 1
    tecla db 0
    fin db 0
    redraw db 1
    
    ; Viewport y cámara
    camera_x db 0
    camera_y db 0
    VIEWPORT_WIDTH equ 160
    VIEWPORT_HEIGHT equ 100
    VIEWPORT_TILES_X equ 10
    VIEWPORT_TILES_Y equ 6
    VIEWPORT_TILES_X_HALF equ 5
    VIEWPORT_TILES_Y_HALF equ 3
    
    ; Sistema de inventario
    gold_count db 0
    crystals_count db 0
    treasures_count db 0
    
    ; Objetivos
    gold_needed db 2
    crystals_needed db 2
    treasures_needed db 2
    
    MAPA_ANCHO equ 20
    MAPA_ALTO equ 15
    TILE_SIZE equ 16
    
    ; Mensajes informativos
    mensaje_titulo db 'ADVENTURE QUEST - Recolecta tesoros y escapa!$'
    mensaje_controles db 'Controles: WASD para mover, ESC para salir$'
    mensaje_objetivo db 'Objetivo: Recolecta 2 ORO, 2 CRISTALES, 2 TESOROS$'
    mensaje_estado db 'Oro: 0/2  Cristales: 0/2  Tesoros: 0/2$'

.code
start:
    mov ax, @data
    mov ds, ax
    
    call show_intro
    call init_screen
    
game_loop:
    cmp byte ptr [redraw], 1
    jne skip_draw
    
    call update_camera
    call clear_and_draw
    mov byte ptr [redraw], 0

skip_draw:
    call get_key_nowait
    cmp byte ptr [tecla], 0
    je game_loop
    
    call move_player
    call check_item_collection
    call check_win
    
    cmp byte ptr [fin], 1
    jne game_loop
    
    call restore_screen
    mov ax, 4c00h
    int 21h

show_intro proc
    ; Mostrar pantalla de introducción
    mov ax, 0003h       ; Modo texto
    int 10h
    
    ; Posicionar cursor y mostrar título
    mov ah, 02h
    mov bh, 0
    mov dh, 5           ; Fila 5
    mov dl, 15          ; Columna 15
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_titulo
    int 21h
    
    ; Mostrar controles
    mov ah, 02h
    mov dh, 8
    mov dl, 10
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_controles
    int 21h
    
    ; Mostrar objetivo
    mov ah, 02h
    mov dh, 10
    mov dl, 8
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_objetivo
    int 21h
    
    ; Esperar tecla
    mov ah, 02h
    mov dh, 15
    mov dl, 20
    int 10h
    
    mov ah, 09h
    mov dx, offset mensaje_presiona
    int 21h
    
    mov ah, 07h         ; Esperar tecla sin eco
    int 21h
    
    ret

mensaje_presiona db 'Presiona cualquier tecla para comenzar...$'
show_intro endp

init_screen proc
    mov ax, 0013h
    int 10h
    ret
init_screen endp

update_camera proc
    push ax
    push bx
    
    ; Centrar cámara en el jugador
    mov al, byte ptr [px]
    sub al, VIEWPORT_TILES_X_HALF
    cmp al, 0
    jge camera_x_positive
    mov al, 0
camera_x_positive:
    mov bl, MAPA_ANCHO - VIEWPORT_TILES_X
    cmp al, bl
    jle camera_x_valid
    mov al, bl
camera_x_valid:
    mov byte ptr [camera_x], al
    
    ; Centrar cámara en Y
    mov al, byte ptr [py]
    sub al, VIEWPORT_TILES_Y_HALF
    cmp al, 0
    jge camera_y_positive
    mov al, 0
camera_y_positive:
    mov bl, MAPA_ALTO - VIEWPORT_TILES_Y
    cmp al, bl
    jle camera_y_valid
    mov al, bl
camera_y_valid:
    mov byte ptr [camera_y], al
    
    pop bx
    pop ax
    ret
update_camera endp

clear_and_draw proc
    call clear_vga_screen
    call draw_background
    call draw_hud
    call draw_viewport
    call draw_player
    call draw_status
    ret
clear_and_draw endp

clear_vga_screen proc
    push ax
    push cx
    push di
    push es
    
    mov ax, 0A000h
    mov es, ax
    mov di, 0
    mov cx, 32000
    mov ax, 0
    rep stosw
    
    pop es
    pop di
    pop cx
    pop ax
    ret
clear_vga_screen endp

draw_background proc
    push ax
    push bx
    push cx
    push dx
    
    ; Dibujar fondo gris claro para el área de juego
    mov dx, 20          ; Comenzar después del HUD
background_y:
    mov cx, 0
background_x:
    mov ah, 0Ch
    mov al, 8           ; Gris oscuro para fondo
    int 10h
    inc cx
    cmp cx, 320
    jl background_x
    inc dx
    cmp dx, 200
    jl background_y
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_background endp

draw_hud proc
    push ax
    push bx
    push cx
    push dx
    
    ; Dibujar barra del HUD con mejor contraste
    mov dx, 0
hud_loop:
    mov cx, 0
hud_col:
    mov ah, 0Ch
    mov al, 1           ; Azul oscuro para HUD
    int 10h
    inc cx
    cmp cx, 320         ; Ancho completo de pantalla
    jl hud_col
    inc dx
    cmp dx, 20
    jl hud_loop
    
    ; Etiquetas y contadores con mejor visibilidad
    mov cx, 5
    mov dx, 3
    call draw_gold_label
    
    mov cx, 25
    mov dx, 8
    mov al, byte ptr [gold_count]
    call draw_simple_number
    
    mov cx, 35
    mov dx, 8
    call draw_slash
    
    mov cx, 45
    mov dx, 8
    mov al, byte ptr [gold_needed]
    call draw_simple_number
    
    mov cx, 80
    mov dx, 3
    call draw_crystal_label
    
    mov cx, 100
    mov dx, 8
    mov al, byte ptr [crystals_count]
    call draw_simple_number
    
    mov cx, 110
    mov dx, 8
    call draw_slash
    
    mov cx, 120
    mov dx, 8
    mov al, byte ptr [crystals_needed]
    call draw_simple_number
    
    mov cx, 160
    mov dx, 3
    call draw_treasure_label
    
    mov cx, 180
    mov dx, 8
    mov al, byte ptr [treasures_count]
    call draw_simple_number
    
    mov cx, 190
    mov dx, 8
    call draw_slash
    
    mov cx, 200
    mov dx, 8
    mov al, byte ptr [treasures_needed]
    call draw_simple_number
    
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_hud endp

