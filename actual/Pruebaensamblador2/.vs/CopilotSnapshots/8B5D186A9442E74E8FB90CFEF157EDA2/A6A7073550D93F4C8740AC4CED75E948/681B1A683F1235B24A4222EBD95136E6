draw_simple_number proc
    push ax
    push bx
    push si
    
    ; Convertir número a formato visual mejorado
    add al, 30h         ; Convertir a ASCII
    
    ; Dibujar número más grande y visible
    mov bx, 0
num_y:
    mov si, 0
num_x:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 15          ; Blanco brillante
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    
    inc si
    cmp si, 8
    jl num_x
    inc bx
