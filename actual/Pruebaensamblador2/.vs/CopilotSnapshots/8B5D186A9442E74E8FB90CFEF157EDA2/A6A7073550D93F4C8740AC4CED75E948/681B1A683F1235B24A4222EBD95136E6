draw_pit_effects endp

draw_player proc
    push ax
    push bx
    push cx
    push dx
    push si
    
    ; Calcular posición del jugador en viewport
    mov al, byte ptr [px]
    sub al, byte ptr [camera_x]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    mov cx, ax
    
    mov al, byte ptr [py]
    sub al, byte ptr [camera_y]
    mov ah, 0
    mov dx, TILE_SIZE
    mul dx
    add ax, 20          ; Offset para HUD
    mov dx, ax
    
    ; Solo dibujar si está visible en viewport
    cmp cx, 160
    jg player_skip
    cmp dx, 116
    jg player_skip
    
    call draw_player_sprite
    
player_skip:
    pop si
    pop dx
    pop cx
    pop bx
    pop ax
    ret
draw_player endp

draw_player_sprite proc
    push ax
    push bx
    push si
    
    ; Dibujar jugador como figura humanoide mejorada y más visible
    ; Cabeza (más grande)
    mov bx, 1
    mov si, 4
head_loop_y:
    push si
    mov si, 4
head_loop_x:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 14          ; Amarillo para piel
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, 12
    jl head_loop_x
    pop si
    inc bx
    cmp bx, 6
    jl head_loop_y
    
    ; Cuerpo (más ancho)
    mov bx, 6
body_loop_y:
    mov si, 5
body_loop_x:
    push cx
    push dx
    mov ah, 0Ch
    mov al, 9           ; Azul para ropa
    add cx, si
    add dx, bx
    int 10h
    pop dx
    pop cx
    inc si
    cmp si, 11
    jl body_loop_x
    inc bx
    cmp bx, 11
    jl body_loop_y
    
    ; Brazos
