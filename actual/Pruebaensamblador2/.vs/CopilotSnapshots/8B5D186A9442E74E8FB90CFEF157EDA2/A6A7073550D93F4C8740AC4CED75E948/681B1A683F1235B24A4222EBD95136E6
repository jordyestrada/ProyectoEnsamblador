draw_pit_effects proc
    push ax
    push bx
    push si
    
    ; Borde gris alrededor del pozo
    mov bx, 0
pit_border_y:
    mov si, 0
pit_border_x:
    push cx
    push dx
    mov ah, 0Ch
    ; Solo dibujar en los bordes
    cmp bx, 2
    jl pit_border_draw
    cmp bx, 14
    jg pit_border_draw
    cmp si, 2
